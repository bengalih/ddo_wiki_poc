/span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Wood\" title=\"Wood\">Wood</a>:</b> <b>Wood</b> is common for use in <a href=\"/page/Quarterstaff\" title=\"Quarterstaff\">Quarterstaffs</a>, <a href=\"/page/Bow\" title=\"Bow\">bows</a>, or <a href=\"/page/Ammo\" class=\"mw-redirect\" title=\"Ammo\">ammo</a>. It is light, but its durability is low.</span></span> \n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Hardness\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">9\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Base Value\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><span style=\"display: none;\">0000000001</span>1<span class=\"popup has&#95;tooltip with-icon basic\">cp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Copper Piece</a></span></span>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">3 lbs\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><b><a href=\"/page/DDO_Store\" title=\"DDO Store\">DDO Store</a></b>, <a href=\"/page/DDO_Store#Fast_Travel\" title=\"DDO Store\">Fast Travel</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+2 Enhancement Bonus</a><span class=\"mw-valign-super\" typeof=\"