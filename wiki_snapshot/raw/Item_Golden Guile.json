  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><figure class=\"mw-halign-left\" typeof=\"mw:File/Frameless\"><a href=\"/page/Category:Neck_items\" title=\"Category:Neck items\"><img src=\"https://images.ddowiki.com/Icon_ItemSlot_Neck.png\" decoding=\"async\" width=\"32\" height=\"32\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure> \n<h2><span class=\"mw-headline\" id=\"Golden_Guile\">Golden Guile</span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #FFBBBB solid; margin: 4px; width: 100%; --bg-color-1:#FFBBBB;--bg-color-1-dark:#573F3F;--bg-color-2:#FFE4E1;--bg-color-2-dark:#3D2C2A;--header-color:#FFBBBB;--header-color-dark:#573F3F;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\" width=\"15%\">Minimum level\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\" width=\"42.5%\">16\n</td>\n<th rowspan=\"11\" class=\"bg-color-2\" style=\"background:#FFE4E1\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Necklace_Generic_Gold.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/Necklace_Generic_Gold.png\" decoding=\"async\" width=\"420\" height=\"398\" class=\"mw-file-element\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Item Type\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">Jewelry / Necklace\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\"><a href=\"/page/Slot\" class=\"mw-redirect\" title=\"Slot\">Slot</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">Neck\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><a href=\"/page/Bind\" title=\"Bind\">Bound to Account&#160;on Acquire</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">170\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Material\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><style data-mw-deduplicate=\"TemplateStyles:r705484\">.mw-parser-output span.popup.has_tooltip{cursor:pointer;position:relative}.mw-parser-output span.popup.has_tooltip.no-icon{border-bottom:1px dashed #999999}.mw-parser-output span.popup.has_tooltip>span.popup.tooltip{background-color:#EEEEEE;background-color:var(--background-color-neutral,#EEEEEE);border:1px solid #333333;border-radius:3px;box-shadow:3px 5px 10px;color:#202122;color:var(--color-base,#202122);cursor:text;display:none;margin:0px;max-width:500px;padding:5px;width:250px;z-index:10000}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.narrow{width:100px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.fill{padding:5px 12px;width:max-content}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.wide{width:450px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.custom{max-width:80vw}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip{display:block;position:absolute}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.above{bottom:100%;top:auto;margin-bottom:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.middle{bottom:auto;top:50%;margin-top:-1em}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.below{bottom:auto;top:100%;margin-top:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.left{left:0px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center{left:50%;margin-left:-125px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.narrow{margin-left:-50px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.fill{left:-262px;margin-left:auto;margin-right:auto;right:-262px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.wide{margin-left:-225px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.right{left:auto;right:0px}</style><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Gold\" class=\"mw-redirect\" title=\"Gold\">Gold</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Gold\" class=\"mw-redirect\" title=\"Gold\">Gold</a>:</b> <b>Gold</b> is an expensive precious metal often used in jewellery. Unfortunately, it is very fragile, and often has low hardness.</span></span> \n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Hardness\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">18\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\" width=\"150\">Base Value\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\" width=\"450\"><span style=\"display: none;\">0006405000</span>6,405<span class=\"popup has&#95;tooltip with-icon basic\">pp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Platinum Piece</a></span></span>&#160;\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">0.10 lbs.\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><b><a href=\"/page/The_Lords_of_Dust\" title=\"The Lords of Dust\">The Lords of Dust</a></b>, <a href=\"/page/Marideth\" title=\"Marideth\">Marideth</a>'s chest\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Dusk_(enchantment)\" title=\"Dusk (enchantment)\">Dusk</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Dusk_(enchantment)\" title=\"Dusk (enchantment)\">Dusk</a>:</b> Equipping this item engulfs you in twilight shadows. Attacks from enemies have a 10% chance to miss you due to concealment.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Diplomacy\" title=\"Diplomacy\">Diplomacy +16</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Diplomacy\" title=\"Diplomacy\">Diplomacy +16</a>:</b> Passive: +16 <a href=\"/page/Competence_bonus\" title=\"Competence bonus\">Competence bonus</a> to the <a href=\"/page/Diplomacy\" title=\"Diplomacy\">Diplomacy</a> skill.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Bluff\" title=\"Bluff\">Bluff +16</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Bluff\" title=\"Bluff\">Bluff +16</a>:</b> Passive: +16 <a href=\"/page/Competence_bonus\" title=\"Competence bonus\">Competence bonus</a> to the <a href=\"/page/Bluff\" title=\"Bluff\">Bluff</a> skill.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Deception#Improved_Deception\" title=\"Deception\">Improved Deception</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Deception#Improved_Deception\" title=\"Deception\">Improved Deception</a>:</b> This item makes your weapons hard to focus upon and thus provides a +5 enhancement bonus to Bluff checks. In addition, while using this item your weapons have a chance to envelop the target in darkness, making them vulnerable to sneak attacks for a short time.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Mythic_Boost\" title=\"Mythic Boost\">Mythic Neck Boost</a> +1 or +3<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Mythic_Boost\" title=\"Mythic Boost\">Mythic Neck Boost</a> +1 or +3:</b> +1 or +3 <a href=\"/page/Mythic_bonus\" title=\"Mythic bonus\">Mythic bonus</a> to <a href=\"/page/Physical_Resistance_Rating\" title=\"Physical Resistance Rating\">Physical</a> and <a href=\"/page/Magical_Resistance_Rating\" title=\"Magical Resistance Rating\">Magical</a> Resistance Ratings.<br />(<i>This is a rare enchantment that does not show up on all drops of this item.</i>)</span></span></li></ul>\n</td>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1; vertical-align: middle;\" rowspan=\"4\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Golden_Guile.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Golden_Guile.png/420px-Golden_Guile.png\" decoding=\"async\" width=\"420\" height=\"403\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Golden_Guile.png 1.5x\" /></a></span>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Upgradeable?\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><a href=\"/page/Epic_Crafting\" title=\"Epic Crafting\">Epic Crafting</a> to <a href=\"/page/Item:Epic_Golden_Guile\" title=\"Item:Epic Golden Guile\">Epic Golden Guile</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Description\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><i>A necklace worn by a Rakshasa with links and a charm made of pure gold. It seems to increase the wearer's ability to convince others of what he or she wants them to believe, even making it possible to distract enemies in the midst of a battle.</i>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Tips\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">\n<p><br />\n</p>\n</td></tr></tbody></table>\n<!-- \nNewPP limit re