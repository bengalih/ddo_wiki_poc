  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><h2><span class=\"mw-headline\" id=\"Soulrazor\">Soulrazor</span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #CCFF99 solid; margin: 4px; width: 100%; --bg-color-1:#CCFF99;--bg-color-1-dark:#3D5F1A;--bg-color-2:#EEFFCC;--bg-color-2-dark:#272F17;--header-color:#CCFF99;--header-color-dark:#3D5F1A;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99; width: 15%;\">Proficiency Class\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC; width: 42.5%;\">Martial Weapon Proficiency\n</td>\n<th class=\"bg-color-2\" rowspan=\"19\" style=\"background:#EEFFCC;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Soulrazor_shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/Soulrazor_shown.jpg\" decoding=\"async\" width=\"420\" height=\"400\" class=\"mw-file-element\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Accepts Sentience?\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">Yes\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Damage and Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">4.80[1d8+3] +15 Slash, Magic, Crystal\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\"><a href=\"/page/Threat_range\" title=\"Threat range\">Critical threat range</a>\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">17-20 / x2\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Weapon Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\"><b><a href=\"/page/Long_Sword\" title=\"Long Sword\">Long Sword</a></b> / Slashing weapons\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Minimum Level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">28\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Required Trait\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">None\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\"><a href=\"/page/Use_Magical_Device\" class=\"mw-redirect\" title=\"Use Magical Device\">Use Magical Device</a> <a href=\"/page/DC\" class=\"mw-redirect\" title=\"DC\">DC</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">No UMD needed\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Handedness\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Attack Mod\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">STR\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Damage Mod\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">STR\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><a href=\"/page/Bind\" title=\"Bind\">Bound to Character&#160;on Acquire</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">350\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Made from\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><style data-mw-deduplicate=\"TemplateStyles:r705484\">.mw-parser-output span.popup.has_tooltip{cursor:pointer;position:relative}.mw-parser-output span.popup.has_tooltip.no-icon{border-bottom:1px dashed #999999}.mw-parser-output span.popup.has_tooltip>span.popup.tooltip{background-color:#EEEEEE;background-color:var(--background-color-neutral,#EEEEEE);border:1px solid #333333;border-radius:3px;box-shadow:3px 5px 10px;color:#202122;color:var(--color-base,#202122);cursor:text;display:none;margin:0px;max-width:500px;padding:5px;width:250px;z-index:10000}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.narrow{width:100px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.fill{padding:5px 12px;width:max-content}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.wide{width:450px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.custom{max-width:80vw}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip{display:block;position:absolute}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.above{bottom:100%;top:auto;margin-bottom:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.middle{bottom:auto;top:50%;margin-top:-1em}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.below{bottom:auto;top:100%;margin-top:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.left{left:0px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center{left:50%;margin-left:-125px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.narrow{margin-left:-50px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.fill{left:-262px;margin-left:auto;margin-right:auto;right:-262px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.wide{margin-left:-225px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.right{left:auto;right:0px}</style><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Crystal\" title=\"Crystal\">Crystal</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Crystal\" title=\"Crystal\">Crystal</a>:</b> <a href=\"/page/Crystal\" title=\"Crystal\">Crystal</a> weapons are able to overcome the protective <a href=\"/page/Damage_reduction\" class=\"mw-redirect\" title=\"Damage reduction\">damage reduction</a> of many <a href=\"/page/Quori\" class=\"mw-redirect\" title=\"Quori\">Quori</a> creatures, which can be resistant to other weapons. <br /> Spell failure chances for armors and shields made from crystal are also decreased by 10%.</span></span> \n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Hardness\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">38\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Base Value\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><span style=\"display: none;\">0011201500</span>11,201<span class=\"popup has&#95;tooltip with-icon basic\">pp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Platinum Piece</a></span></span>&#160;5<span class=\"popup has&#95;tooltip with-icon basic\">gp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Gold Piece</a></span></span>&#160;\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">4 lbs\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><b><a href=\"/page/Schism_Shard_Crafting\" title=\"Schism Shard Crafting\">Schism Shard Crafting</a></b>, Turn in 5 <a href=\"/page/Item:Schism_Shard\" title=\"Item:Schism Shard\">Schism Shards</a>, <a href=\"/page/Item:Legendary_Echo_of_Blackrazor\" title=\"Item:Legendary Echo of Blackrazor\">Legendary Echo of Blackrazor</a> and <a href=\"/page/Item:Sentient_Jewel_of_Blackrazor\" title=\"Item:Sentient Jewel of Blackrazor\">Sentient Jewel of Blackrazor</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+15 Enhancement Bonus</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+15 Enhancement Bonus</a>:</b> +15 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">enhancement bonus</a> to <a href=\"/page/Attack_roll\" title=\"Attack roll\">attack</a> and <a href=\"/page/Damage_roll\" title=\"Damage roll\">damage rolls</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Overwhelming_Stealer_of_Souls\" title=\"Overwhelming Stealer of Souls\">Overwhelming Stealer of Souls</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Overwhelming_Stealer_of_Souls\" title=\"Overwhelming Stealer of Souls\">Overwhelming Stealer of Souls</a>:</b> This weapon tears at the very essence of your foes. On any strike, this weapon applies a single stack of Soul Scar, which reduces your target's Will Saves, Armor Class, and Fortification by 1 per stack, max 10. Occasionally, this weapon attempts to rip the life from your foe, as if it were the victim of a <a href=\"/page/Phantasmal_Killer\" title=\"Phantasmal Killer\">Phantasmal Killer</a> spell with a DC of 100 versus Will. Bosses (and enemies with more than 10,000 hit points) are immune to this effect. Killing a monster will consume your soul, adding a stack of Consumed Soul to you. Consumed Souls stack up to 20 times, and linger for 20 seconds. Each one provides a +1 <a href=\"/page/Profane_bonus\" title=\"Profane bonus\">Profane bonus</a> to Damage and <a href=\"/page/Melee_Power\" title=\"Melee Power\">Melee Power</a>. If you block or unequip this weapon, the Consumed Souls will be released.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Keen\" title=\"Keen\">Keen</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Keen\" title=\"Keen\">Keen</a>:</b> Passive: The base critical <a href=\"/page/Threat_range\" title=\"Threat range\">threat range</a> of this weapon is doubled. This does not stack with <a href=\"/page/Improved_Critical\" title=\"Improved Critical\">Improved Critical</a> feat. <a href=\"/page/Vorpal_Strike\" title=\"Vorpal Strike\">Vorpal Strikes</a> by this weapon also bypass all <a href=\"/page/Fortification\" title=\"Fortification\">Fortification</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Entropic\" title=\"Entropic\">Entropic 6</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Entropic\" title=\"Entropic\">Entropic 6</a>:</b> This weapon is intensely powerful, and crackles with destructive, unpredictable magic. It deals an additional 6d6 untyped damage on each hit.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Vampirism\" title=\"Vampirism\">Vampirism 3</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Vampirism\" title=\"Vampirism\">Vampirism 3</a>:</b> This weapon thirsts for the blood of your enemies, healing you for +3d2 hit points with each hit.<br /><i>Note: internal cooldown of 1 second.</i></span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Psychic_Ward\" title=\"Psychic Ward\">Psychic Ward</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Psychic_Ward\" title=\"Psychic Ward\">Psychic Ward</a>:</b> This items wards you against mind-altering effects and spells, such  as Charm and Domination.</span></span></li>\n<li><style data-mw-deduplicate=\"TemplateStyles:r705465\">.mw-parser-output span.popup.augment.orange>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Orange\"]{background-color:#F4A460;border-color:#0B5B9F}.mw-parser-output span.popup.augment.purple>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Purple\"]{background-color:#DDA0DD;border-color:#225F22}.mw-parser-output span.popup.augment.green>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Green\"]{background-color:#90EE90;border-color:#6F116F}.mw-parser-output span.popup.augment.yellow>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Yellow\"]{background-color:#EEE8AA;border-color:#111755}.mw-parser-output span.popup.augment.blue>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Blue\"]{background-color:#87CEFA;border-color:#783105}.mw-parser-output span.popup.augment.red>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Red\"]{background-color:#FA8072;border-color:#057F8D}.mw-parser-output span.popup.augment.colorless>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Colorless\"]{background-color:#F8F8FF;border-color:#070700}.mw-parser-output span.popup.augment.sun>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Sun\"]{background-color:#FFFFC0;border-color:#00003F}.mw-parser-output span.popup.augment.moon>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Moon\"]{background-color:#C0FFFF;border-color:#3F0000}.mw-parser-output span.popup.augment>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a{border:1px solid;border-radius:3px;padding:1px 3px}.mw-parser-output span.popup.augment>span.title>a{color:#003366}.mw-parser-output span.popup.augment>span.title>a:visited{color:#040050}.mw-parser-output span.popup.augment>span.tooltip::after{content:\" augments.\"}</style><span class=\"popup has&#95;tooltip with-icon augment red\"><span class=\"title\"><a href=\"/page/Augment_Slot\" title=\"Augment Slot\">Red Augment Slot</a></span><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><a href=\"/page/Category:Red_augments\" title=\"Category:Red augments\">Red</a> and <a href=\"/page/Category:Colorless_augments\" title=\"Category:Colorless augments\">Colorless</a></span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon augment orange\"><span class=\"title\"><a href=\"/page/Augment_Slot\" title=\"Augment Slot\">Orange Augment Slot</a></span><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><a href=\"/page/Category:Orange_augments\" title=\"Category:Orange augments\">Orange</a>, <a href=\"/page/Category:Red_augments\" title=\"Category:Red augments\">Red</a>, <a href=\"/page/Category:Yellow_augments\" title=\"Category:Yellow augments\">Yellow</a>, and <a href=\"/page/Category:Colorless_augments\" title=\"Category:Colorless augments\">Colorless</a></span></span></li></ul>\n</td>\n<td class=\"bg-color-2\" style=\"background:#EFC; vertical-align: middle;\" rowspan=\"4\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Soulrazor.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Soulrazor.png/420px-Soulrazor.png\" decoding=\"async\" width=\"420\" height=\"713\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Soulrazor.png 1.5x\" /></a></span>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Upgradeable?\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n<p><a href=\"/page/Threads_of_Fate\" class=\"mw-redirect\" title=\"Threads of Fate\">Threads of Fate</a>\n</p>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Description\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><i>I delight in your voracity.</i>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Tips\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n<p><b>Bug: </b> HP limit of <span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Overwhelming_Stealer_of_Souls\" title=\"Overwhelming Stealer of Souls\">Overwhelming Stealer of Souls</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Overwhelming_Stealer_of_Souls\" title=\"Overwhelming Stealer of Souls\">Overwhelming Stealer of Souls</a>:</b> This weapon tears at the very essence of your foes. On any strike, this weapon applies a single stack of Soul Scar, which reduces your target's Will Saves, Armor Class, and Fortification by 1 per stack, max 10. Occasionally, this weapon attempts to rip the life from your foe, as if it were the victim of a <a href=\"/page/Phantasmal_Killer\" title=\"Phantasmal Killer\">Phantasmal Killer</a> spell with a DC of 100 versus Will. Bosses (and enemies with more than 10,000 hit points) are immune to this effect. Killing a monster will consume your soul, adding a stack of Consumed Soul to you. Consumed Souls stack up to 20 times, and linger for 20 seconds. Each one provides a +1 <a href=\"/page/Profane_bonus\" title=\"Profane bonus\">Profane bonus</a> to Damage and <a href=\"/page/Melee_Power\" title=\"Melee Power\">Melee Power</a>. If you block or unequip this weapon, the Consumed Souls will be released.</span></span>  is only 5,000 instead of 10,000.\n</p><p>Can be upgraded with Threads of Fate to gain:\n</p>\n<ul><li>Tier 1: <span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Mythic_Boost\" title=\"Mythic Boost\">Mythic Weapon Boost</a> +2<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Mythic_Boost\" title=\"Mythic Boost\">Mythic Weapon Boost</a> +2:</b> +2 <a href=\"/page/Mythic_bonus\" title=\"Mythic bonus\">Mythic bonus</a> to <a href=\"/page/Melee_Power\" title=\"Melee Power\">Melee</a>, <a href=\"/page/Ranged_Power\" title=\"Ranged Power\">Ranged</a>, and <a href=\"/page/Universal_Spell_Power\" title=\"Universal Spell Power\">Universal Spell Power</a>.<br />(<i>This is a rare enchantment that does not show up on all drops of this item.</i>)</span></span></li>\n<li>Tier 2: <span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Mythic_Boost\" title=\"Mythic Boost\">Mythic Weapon Boost</a> +2<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Mythic_Boost\" title=\"Mythic Boost\">Mythic Weapon Boost</a> +2:</b> +2 <a href=\"/page/Mythic_bonus\" title=\"Mythic bonus\">Mythic bonus</a> to <a href=\"/page/Melee_Power\" title=\"Melee Power\">Melee</a>, <a href=\"/page/Ranged_Power\" title=\"Ranged Power\">Ranged</a>, and <a href=\"/page/Universal_Spell_Power\" title=\"Universal Spell Power\">Universal Spell Power</a>.<br />(<i>This is a rare enchantment that does not show up on all drops of this item.</i>)</span></span> → <span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Mythic_Boost\" title=\"Mythic Boost\">Mythic Weapon Boost</a> +4<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Mythic_Boost\" title=\"Mythic Boost\">Mythic Weapon Boost</a> +4:</b> +4 <a href=\"/page/Mythic_bonus\" title=\"Mythic bonus\">Mythic bonus</a> to <a href=\"/page/Melee_Power\" title=\"Melee Power\">Melee</a>, <a href=\"/page/Ranged_Power\" title=\"Ranged Power\">Ranged</a>, and <a href=\"/page/Universal_Spell_Power\" title=\"Universal Spell Power\">Universal Spell Power</a>.<br />(<i>This is a rare enchantment that does not show up on all drops of this item.</i>)</span></span></li></ul>\n</td></tr></tbody></table>\n<!-- \nNewPP limit report\nCached time: 20260817224646\nCache expiry: 86400\nReduced expiry: false\nComplications: []\nCPU time usage: 0.106 seconds\nReal time usage: 0.148 sec