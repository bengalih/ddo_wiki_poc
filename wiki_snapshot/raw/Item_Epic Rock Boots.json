px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Earthgrab_Guard\" class=\"mw-redirect\" title=\"Earthgrab Guard\">Earthgrab&#32;Guard</a>:</b> This item stores the implacable strength of the earth deep within. When the wearer of this item is successfully attacked in melee, this power occasionally comes to the surface, calling on the earth to erupt from the ground and hold an enemy in place.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Immunity_to_Slippery_Surfaces\" title=\"Immunity to Slippery Surfaces\">Immunity to Slippery Surfaces</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Immunity_to_Slippery_Surfaces\" title=\"Immunity to Slippery Surfaces\">Immunity to Slippery Surfaces</a>:</b> The wearer of this item is not affected when walking on slippery surfaces.</span></span></li></ul></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Vaults_of_the_Artificers_loot\" title=\"Vaults of the Artificers loot\">Upgradeable - Tier 2</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><a href=\"/page/Vaults_of_the_Artificers_loot\" title=\"