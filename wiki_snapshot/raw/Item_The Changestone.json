  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><figure class=\"mw-halign-left\" typeof=\"mw:File/Frameless\"><a href=\"/page/Category:Trinket_items\" title=\"Category:Trinket items\"><img src=\"https://images.ddowiki.com/Icon_ItemSlot_Trinket.png\" decoding=\"async\" width=\"32\" height=\"32\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure> \n<h2><span class=\"mw-headline\" id=\"The_Changestone\">The Changestone</span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #FFBBBB solid; margin: 4px; width: 100%; --bg-color-1:#FFBBBB;--bg-color-1-dark:#573F3F;--bg-color-2:#FFE4E1;--bg-color-2-dark:#3D2C2A;--header-color:#FFBBBB;--header-color-dark:#573F3F;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\" width=\"15%\">Minimum level\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\" width=\"42.5%\">29\n</td>\n<th rowspan=\"11\" class=\"bg-color-2\" style=\"background:#FFE4E1\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:QuestionOrb.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/QuestionOrb.png\" decoding=\"async\" width=\"420\" height=\"398\" class=\"mw-file-element\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Item Type\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">Jewelry / Trinket\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\"><a href=\"/page/Slot\" class=\"mw-redirect\" title=\"Slot\">Slot</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">Trinket\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><a href=\"/page/Bind\" title=\"Bind\">Bound to Character&#160;on Acquire</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">390\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Material\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><style data-mw-deduplicate=\"TemplateStyles:r705484\">.mw-parser-output span.popup.has_tooltip{cursor:pointer;position:relative}.mw-parser-output span.popup.has_tooltip.no-icon{border-bottom:1px dashed #999999}.mw-parser-output span.popup.has_tooltip>span.popup.tooltip{background-color:#EEEEEE;background-color:var(--background-color-neutral,#EEEEEE);border:1px solid #333333;border-radius:3px;box-shadow:3px 5px 10px;color:#202122;color:var(--color-base,#202122);cursor:text;display:none;margin:0px;max-width:500px;padding:5px;width:250px;z-index:10000}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.narrow{width:100px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.fill{padding:5px 12px;width:max-content}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.wide{width:450px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.custom{max-width:80vw}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip{display:block;position:absolute}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.above{bottom:100%;top:auto;margin-bottom:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.middle{bottom:auto;top:50%;margin-top:-1em}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.below{bottom:auto;top:100%;margin-top:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.left{left:0px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center{left:50%;margin-left:-125px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.narrow{margin-left:-50px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.fill{left:-262px;margin-left:auto;margin-right:auto;right:-262px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.wide{margin-left:-225px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.right{left:auto;right:0px}</style><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Gem_(material)\" title=\"Gem (material)\">Gem</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Gem_(material)\" title=\"Gem (material)\">Gem</a>:</b> Items made of <b>gem</b> are generally extremely durable and have a very high <a href=\"/page/Hardness\" title=\"Hardness\">hardness</a>. Most commonly used to make trinkets and docents.</span></span> \n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Hardness\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">49\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\" width=\"150\">Base Value\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\" width=\"450\"><span style=\"display: none;\">0011620000</span>11,620<span class=\"popup has&#95;tooltip with-icon basic\">pp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Platinum Piece</a></span></span>&#160;\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">0.10 lbs\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><b><a href=\"/page/The_Dryad_and_the_Demigod\" title=\"The Dryad and the Demigod\">The Dryad and the Demigod</a></b>, End chest and optional chest\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">\n<ul><li>One of the following:\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Strength\" title=\"Strength\"> Strength +13</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Strength\" title=\"Strength\"> Strength +13</a></b>: This item gives the wearer the power of Ogre Strength, granting a +13 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Strength.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Dexterity\" title=\"Dexterity\"> Dexterity +13</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Dexterity\" title=\"Dexterity\"> Dexterity +13</a></b>: This item makes the wearer more nimble and dexterous, granting a +13 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Dexterity.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Constitution\" title=\"Constitution\"> Constitution +13</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Constitution\" title=\"Constitution\"> Constitution +13</a></b>: This item gives the wearer improved health, granting a +13 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Constitution.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Intelligence\" title=\"Intelligence\"> Intelligence +13</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Intelligence\" title=\"Intelligence\"> Intelligence +13</a></b>: This item focuses the power of the wearer's mind, granting a +13 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Intelligence.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Wisdom\" title=\"Wisdom\"> Wisdom +13</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Wisdom\" title=\"Wisdom\"> Wisdom +13</a></b>: This item makes the wearer more in tune with her surroundings, granting a +13 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Wisdom.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Charisma\" title=\"Charisma\"> Charisma +13</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Charisma\" title=\"Charisma\"> Charisma +13</a></b>: This item makes the wearer have more flair, granting a +13 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Charisma.</span></span></li></ul></li>\n<li>One of the following:\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Doublestrike\" title=\"Doublestrike\"> Doublestrike 15%</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Doublestrike\" title=\"Doublestrike\"> Doublestrike 15%</a>:</b> Passive: 15% <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Doublestrike. (Doublestrike is a chance to score an additional hit with a melee attack.)</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Doubleshot\" title=\"Doubleshot\"> Doubleshot 8%</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Doubleshot\" title=\"Doubleshot\"> Doubleshot 8%</a>:</b> Passive: 8% <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Doubleshot. (Doubleshot is a chance to score an additional hit with a ranged attack.)</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Accuracy\" title=\"Accuracy\"> Accuracy +21</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Accuracy\" title=\"Accuracy\"> Accuracy +21</a>:</b> Passive: +21 <a href=\"/page/Competence_bonus\" title=\"Competence bonus\">Competence bonus</a> to <a href=\"/page/Attack_roll\" title=\"Attack roll\">attack rolls</a></span></span></li></ul></li>\n<li>One of the following:\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Seeker\" title=\"Seeker\"> Seeker +13</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Seeker\" title=\"Seeker\"> Seeker +13</a>:</b> Provides a +13 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to confirm critical hits, and a +13 Enhancement bonus to critical hit damage (before multipliers are applied).</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Deadly\" title=\"Deadly\"> Deadly +11</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Deadly\" title=\"Deadly\"> Deadly +11</a>:</b> +11 <a href=\"/page/Competence_bonus\" title=\"Competence bonus\">Competence bonus</a> to weapon damage.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Deception\" title=\"Deception\"> Deception +11</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Deception\" title=\"Deception\"> Deception +11</a>:</b> +11 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to hit and +17 to damage for any hit that would qualify as a sneak attack.</span></span></li></ul></li>\n<li>One of the following:\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Speed\" title=\"Speed\"> Speed +30%</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Speed\" title=\"Speed\"> Speed +30%</a>:</b> +30% <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">enhancement bonus</a> to <a href=\"/page/Movement_speed\" class=\"mw-redirect\" title=\"Movement speed\">movement speed</a>, 15% bonus to <a href=\"/page/Attack_speed\" title=\"Attack speed\">attack speed</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Deadly\" title=\"Deadly\">Insightful Deadly +5</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Deadly\" title=\"Deadly\">Insightful Deadly +5</a>:</b> +5 <a href=\"/page/Insight_bonus\" title=\"Insight bonus\">Insight bonus</a> to weapon damage.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Accuracy\" title=\"Accuracy\">Insightful Accuracy +10</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Accuracy\" title=\"Accuracy\">Insightful Accuracy +10</a>:</b> Passive: +10 <a href=\"/page/Insight_bonus\" title=\"Insight bonus\">Insight bonus</a> to <a href=\"/page/Attack_roll\" title=\"Attack roll\">attack rolls</a><