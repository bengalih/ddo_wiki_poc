ic_D%26D_III_Card_shown.png/250px-Classic_D%26D_III_Card_shown.png\" decoding=\"async\" width=\"250\" height=\"336\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Classic_D%26D_III_Card_shown.png 1.5x\" /></a></span></span></span> &amp; <span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Classical_D%26D_Cards#Classical_D&amp;D_Card_IV\" title=\"Classical D&amp;D Cards\">Card IV: Mimic</a><span class=\"popup tooltip left below\" style=\"text-align: center;\"><span typeof=\"mw:File\"><a href=\"/page/Classical_D%26D_Cards#Classical_D&amp;D_Card_IV\" title=\"Classical D&amp;D Cards\"><img src=\"https://images.ddowiki.com/thumb/Classic_D%26D_IV_Card_shown.png/250px-Classic_D%26D_IV_Card_shown.png\" decoding=\"async\" width=\"250\" height=\"336\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Classic_D%26D_IV_Card_shown.png 1.5x\" /></a></span></span></span>&#32;for&#32;2; <a href=\"/page/DDO_Store#Fast_Travel\" title=\"DDO Store\">Fast Travel</a> from the DDO Store; or as a <a href=\"/page/Special_event_history#Festival_of_the_Traveler\" title=\"Special event history\">Festival of the Traveler 2010</a> Special event common reward\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+1 Enhancement Bonus</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+1 Enhancement Bonus</a>:</b> +1 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">enhancement bonus</a> to <a href=\"/page/Attack_roll\" title=\"Attack roll\">attack</a> and <a href=\"/page/Damage_roll\" title=\"Damage roll\">damage rolls</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Teleport\" title=\"Teleport\">Teleport</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><b><a href=\"/page/Teleport\" title=\"Teleport\">Teleport</a></b><br /><b>Caster level:</b> 9<br /><b>Charges: </b>50 (None/day)</span></span> <b>—</b> 50 Charges&#32;(Recharged/Day:None)</li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Mythic_Boost\" title=\"Mythic Boost\">Mythic Weapon Boost</a> +2 or +4<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Mythic_Boost\" title=\"Mythic Boost\">Mythic Weapon Boost</a> +2 or +4:</b> +2 or +4 <a href=\"/page/Mythic_bonus\" title=\"Mythic bonus\">Mythic bonus</a> to <a href=\"/page/Melee_Power\" title=\"Melee Power\">Melee</a>, <a href=\"/page/Ranged_Power\" title=\"Ranged Power\">Ranged</a>, and <a href=\"/page/Universal_Spell_Power\" title=\"Universal Spell Power\">Universal Spell Power</a>.<br />(<i>This is a rare enchantment that does not show up on all drops of this item.</i>)</span></span></li></ul>\n</td>\n<td class=\"bg-color-2\" style=\"background:#EFC; vertical-align: middle;\" rowspan=\"4\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Rod_of_Teleport.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/Rod_of_Teleport.png\" decoding=\"async\" width=\"420\" height=\"502\" class=\"mw-file-element\" /></a></span>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Upgradeable?\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Description\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><i>A sceptre containing multiple charges of <a href=\"/page/Teleport\" title=\"Teleport\">Teleport</a>. This spell can instantly transport you to a variety of locations.</i>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Tips\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n<p class=\"mw-empty-elt\">\n</p>\n<ul><li><span style=\"background-color: initial; color: #FF0000;\"><span style=\"font-size: larger; font-weight: inherit;\"><i>This item cannot be fed to <a href=\"/page/Sentient_Weapon\" title=\"Sentient Weapon\">sentient jewels</a>.</i></span></span></li>\n<li class=\"mw-empty-elt\"></li></ul>\n<figure class=\"mw-halign-right\" typeof=\"mw:File/Thumb\"><a href=\"/page/File:Teleport.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Teleport.jpg/300px-Teleport.jpg\" decoding=\"async\" width=\"300\" height=\"540\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Teleport.jpg 1.5x\" /></a><figcaption>The Teleport destination selection screen</figcaption></figure>\n<ul><li>The rods received from the Anniversary Card Collection are <a href=\"/page/Bind\" title=\"Bind\">Bound to Character&#160;on Acquire</a>.</li>\n<li>The ones from the 2010 Festival were all <a href=\"/page/Bind\" title=\"Bind\">Bound to Character&#160;on Acquire</a>.</li>\n<li>The ones purchased from the store are <a href=\"/page/Bind\" title=\"Bind\">Bound to Account&#160;on Acquire</a>.</li>\n<li><b><a href=\"/page/Teleport\" title=\"Teleport\">Teleport</a> Destinations:</b>\n<ul><li><a href=\"/page/Fare_Trades\" title=\"Fare Trades\">Fare Trades</a> shop in <a href=\"/page/House_Deneith\" title=\"House Deneith\">House Deneith</a></li>\n<li><a href=\"/page/House_of_Wizardry\" title=\"House of Wizardry\">House of Wizardry</a> shop in <a href=\"/page/House_Jorasco\" title=\"House Jorasco\">House Jorasco</a></li>\n<li><a href=\"/page/Kundarak_Bank\" title=\"Kundarak Bank\">Kundarak Bank</a> in <a href=\"/page/House_Kundarak\" title=\"House Kundarak\">House Kundarak</a></li>\n<li><a href=\"/page/The_Marketplace\" title=\"The Marketplace\">The Marketplace</a></li>\n<li><a href=\"/page/House_Phiarlan\" title=\"House Phiarlan\">House Phiarlan</a>, by the <a href=\"/page/Trainer\" class=\"mw-redirect\" title=\"Trainer\">Trainers</a></li>\n<li><a href=\"/page/The_Portable_Hole\" title=\"The Portable Hole\">The Portable Hole</a></li>\n<li><a href=\"/page/Meridia\" title=\"Meridia\">Meridia</a> - Requires completing the quest by the same name, which can be started in the <a href=\"/page/Tower_of_the_Twelve\" class=\"mw-redirect\" title=\"Tower of the Twelve\">Tower of the Twelve</a>.</li>\n<li><a href=\"/page/The_Twelve\" title=\"The Twelve\">The Twelve</a></li>\n<li><a href=\"/page/The_Harbor\" title=\"The Harbor\">The Harbor</a> - Next to the entrance to the <a href=\"/page/Inspired_Quarter\" class=\"mw-redirect\" title=\"Inspired Quarter\">Inspired Quarter</a></li>\n<li><a href=\"/page/Essence_Crafting\" title=\"Essence Crafting\">The Crafting Hall</a> located in <a href=\"/page/House_Cannith\" title=\"House Cannith\">House Cannith</a></li>\n<li><a href=\"/page/The_Necropolis\" title=\"The Necropolis\">Lower Necropolis</a></li>\n<li><a href=\"/page/The_Gatekeepers%27_Grove\" title=\"The Gatekeepers&#39; Grove\">The Gatekeepers' Grove</a></li></ul></li></ul>\n</td></tr></tbody></table>\n<!-- \nNewPP limit report\nCached time: 20260817224846\nCache expiry: 86