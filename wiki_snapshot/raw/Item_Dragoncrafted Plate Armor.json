  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><table style=\"text-align: center; background-color: #D9D9FF; background-color: rgba(0, 0, 255, 0.15); border: 1px #4A4ABA solid; margin: 0.25em; padding: 0.20em; width: 100%;\">\n\n<tbody><tr style=\"font-size: 1.5em;\">\n<td rowspan=\"3\" style=\"vertical-align: middle; width: 60px;\"><figure class=\"mw-halign-center\" typeof=\"mw:File/Frameless\"><a href=\"/page/File:History_shield-book-sword.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/40px-History_shield-book-sword.png\" decoding=\"async\" width=\"40\" height=\"57\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/60px-History_shield-book-sword.png 1.5x, https://images.ddowiki.com/thumb/History_shield-book-sword.png/80px-History_shield-book-sword.png 2x\" /></a><figcaption></figcaption></figure>\n</td>\n<th><a href=\"/page/Category:History\" title=\"Category:History\">History</a>\n</th>\n<td rowspan=\"3\" style=\"vertical-align: middle; width: 60px;\"><figure class=\"mw-halign-center\" typeof=\"mw:File/Frameless\"><a href=\"/page/File:History_shield-book-sword.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/40px-History_shield-book-sword.png\" decoding=\"async\" width=\"40\" height=\"57\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/60px-History_shield-book-sword.png 1.5x, https://images.ddowiki.com/thumb/History_shield-book-sword.png/80px-History_shield-book-sword.png 2x\" /></a><figcaption></figcaption></figure>\n</td></tr>\n<tr style=\"font-size: 1.2em;\">\n<td><i>This page is about an item that no longer drops in-game.</i>\n</td></tr>\n<tr style=\"font-size: 0.8em;\">\n<td>If you can verify that the item still drops, please <span class=\"plainlinks\"><a class=\"external text\" href=\"https://ddowiki.com/index.php?title=Item:Dragoncrafted_Plate_Armor&amp;action=edit#editform\"><span class=\"edit-link\" style=\"display: inherit;\" title=\"edit this page\">edit this page</span></a></span> and remove this template.\n</td></tr></tbody></table>\n<h2><span class=\"mw-headline\" id=\"Dragoncrafted_Plate_Armor\">Dragoncrafted Plate Armor</span></h2>\n<table style=\"clear: right; border: 1px solid #FFD700; padding: 4px; width: 100%; --bg-color-1:#DDBB00;--bg-color-1-dark:#635400;--bg-color-2:#FFFACD;--bg-color-2-dark:#433E14;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\" width=\"15%\">Armor Type\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\" width=\"42.5%\">Full Plate\n</td>\n<th class=\"bg-color-2\" rowspan=\"15\" style=\"background:#FFFACD;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Dragoncrafted_Plate_Armor_shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/Dragoncrafted_Plate_Armor_shown.jpg\" decoding=\"async\" width=\"420\" height=\"589\" class=\"mw-file-element\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Feat Requirement\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\">Heavy Armor Proficiency\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Race Absolutely Excluded\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\"><a href=\"/page/Warforged\" title=\"Warforged\">Warforged</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #F0DC82;\">Minimum Level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #FFFACD;\">10\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\"><a href=\"/page/Bind\" title=\"Bind\">Bound to Character&#160;on Acquire</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\"><a href=\"/page/Armor_bonus\" title=\"Armor bonus\">Armor Bonus</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\">+16\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Maximum Dexterity Bonus\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\">1\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\"><a href=\"/page/Armor_check_penalty\" title=\"Armor check penalty\">Armor Check Penalty</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\">-5\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\"><a href=\"/page/Arcane_spell_failure\" title=\"Arcane spell failure\">Arcane Spell Failure</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\">35%\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\">156\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Material\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\"><style data-mw-deduplicate=\"TemplateStyles:r705484\">.mw-parser-output span.popup.has_tooltip{cursor:pointer;position:relative}.mw-parser-output span.popup.has_tooltip.no-icon{border-bottom:1px dashed #999999}.mw-parser-output span.popup.has_tooltip>span.popup.tooltip{background-color:#EEEEEE;background-color:var(--background-color-neutral,#EEEEEE);border:1px solid #333333;border-radius:3px;box-shadow:3px 5px 10px;color:#202122;color:var(--color-base,#202122);cursor:text;display:none;margin:0px;max-width:500px;padding:5px;width:250px;z-index:10000}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.narrow{width:100px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.fill{padding:5px 12px;width:max-content}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.wide{width:450px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.custom{max-width:80vw}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip{disp