r>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">0.10 lbs\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><b><a href=\"/page/Army_of_Shadow\" title=\"Army of Shadow\">Army of Shadow</a></b>, <a href=\"/page/Rantha\" title=\"Rantha\">Rantha</a>'s chest &amp; end chest (Heroic Hard)\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Reinforced_Fists\" title=\"Reinforced Fists\">Reinforced Fists</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Reinforced_Fists\" title=\"Reinforced Fists\">Reinforced Fists</a>:</b> This item surrounds your fists with kinetic energy. Your unarmed damage is boosted by one half die.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Incite\" title=\"Incite\">  Incite +20</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Incite\" title=\"Incite\">  Incite +20</a>:</b> +20% <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to increased <a href=\"/page/Threat\" class=\"mw-redirect\" title=\"Threat\">threat</a> generation from melee damage</span></span></li>\n<li>One of the following:\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Armor_Bonus\" class=\"mw-redirect\" title=\"Armor Bonus\">Armor Bonus +8</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Armor_Bonus\" class=\"mw-redirect\" title=\"Armor Bonus\">Armor Bonus +8</a>:</b> This item surrounds the wearer with an invisible but tangible field of force, granting +8 armor bonus to AC, just as though he were wearing armor.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Acid_Resistance\" title=\"Acid Resistance\">Acid Resistance +30</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Acid_Resistance\" title=\"Acid Resistance\">Acid Resistance +30</a>:</b> Passive: +30 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to your Acid Resistance.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Cold_Resistance\" title=\"Cold Resistance\">Cold Resistance +30</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Cold_Resistance\" title=\"Cold Resistance\">Cold Resistance +30</a>:</b> Passive: +30 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to your Cold Resistance.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Fire_Resistance\" title=\"Fire Resistance\">Fire Resistance +30</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Fire_Resistance\" title=\"Fire Resistance\">Fire Resistance +30</a>:</b> Passive: +30 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to your Fire Resistance.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Electric_Resistance\" title=\"Electric Resistance\">Electric Resistance +30</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Electric_Resistance\" title=\"Electric Resistance\">Electric Resistance +30</a>:</b> Passive: +30 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to your Electric Resistance.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Sonic_Resistance\" title=\"Sonic Resistance\">Sonic Resistance +30</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Sonic_Resistance\" title=\"Sonic Resistance\">Sonic Resistance +30</a>:</b> Passive: +30 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to your Sonic Resistance.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Fortification\" title=\"Fortification\">Fortification  +105%</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Fortification\" title=\"Fortification\">Fortification  +105%</a>:</b> +105% <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to reduced chance of taking critical damage on a critical hit.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Strength\" title=\"Strength\"> Strength +6</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Strength\" title=\"Strength\"> Strength +6</a></b>: This item gives the wearer the power of Ogre Strength, granting a +6 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Strength.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Dexterity\" title=\"Dexterity\"> Dexterity +6</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Dexterity\" title=\"Dexterity\"> Dexterity +6</a></b>: This item makes the wearer more nimble and dexterous, granting a +6 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Dexterity.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Constitution\" title=\"Constitution\"> Constitution +6</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Constitution\" title=\"Constitution\"> Constitution +6</a></b>: This item gives the wearer improved health, granting a +6 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Constitution.</span></span></li></ul></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Mythic_Boost\" title=\"Mythic Boost\">Mythic Wrist Boost</a> +1 or +3<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Mythic_Boost\" title=\"Mythic Boost\">Mythic Wrist Boost</a> +1 or +3:</b> +1 or +3 <a href=\"/page/Mythic_bonus\" title=\"Mythic bonus\">Mythic bonus</a> to <a href=\"/page/Physical_Resistance_Rating\" title=\"Physical Resistance Rating\">Physical</a> and <a href=\"/page/Magical_Resistance_Rating\" title=\"Magical Resistance Rating\">Magical</a> Resistance Ratings.<br />(<i>This is a rare enchantment that does not show up on all drops of this item.</i>)</span></span></li></ul>\n</td>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1; vertical-align: middle;\" rowspan=\"4\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Prisoner%27s_Manacles_(Level_15).png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Prisoner%27s_Manacles_%28Level_15%29.png/420px-Prisoner%27s_Manacles_%28Level_15%29.png\" decoding=\"async\" width=\"420\" height=\"301\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Prisoner%27s_Manacles_%28Level_15%29.png 1.5x\" /></a></span>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Upgradeable?\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Description\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><i>Broken chains, yet still a Prisoner.</i>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Tips\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">\n<p><br />\n</p>\n</td></tr></tbody></table>\n<!-- \nNewPP limit report\nCached time: 20260817224013\nCache expiry: 86400\nReduced expiry: false\nComplications: [no‐toc]\nCPU time usage: 0.095 seconds\nReal time usage: 0.147 seconds\nPreprocessor visited node count: 5805