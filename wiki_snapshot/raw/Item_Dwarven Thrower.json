tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+3 Enhancement Bonus</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+3 Enhancement Bonus</a>:</b> +3 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">enhancement bonus</a> to <a href=\"/page/Attack_roll\" title=\"Attack roll\">attack</a> and <a href=\"/page/Damage_roll\" title=\"Damage roll\">damage rolls</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Extra_damage_vs_Giants\" title=\"Extra damage vs Giants\">Extra damage vs Giants</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Extra_damage_vs_Giants\" title=\"Extra damage vs Giants\">Extra damage vs Giants</a>:</b> This weapon deals an additional 2 to 16 damage against <a href=\"/page/Giant_type\" title=\"Giant type\">Giants</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Returning\" title=\"Returning\">Returning</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10p