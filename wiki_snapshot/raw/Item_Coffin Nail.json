ass=\"bg-color-2\" style=\"background:#EFC\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+7 Enhancement Bonus</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+7 Enhancement Bonus</a>:</b> +7 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">enhancement bonus</a> to <a href=\"/page/Attack_roll\" title=\"Attack roll\">attack</a> and <a href=\"/page/Damage_roll\" title=\"Damage roll\">damage rolls</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Returning\" title=\"Returning\">Returning</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><b><a href=\"/page/Returning\" title=\"Returning\">Returning</a>:</b> This missile will return to you.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Doubleshot\" title=\"Doubleshot\"> Doubleshot 8%</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Doubleshot\" title=\"Doubleshot\"> Doubleshot 8%</a>:</b> Passive: 8% <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Doubleshot. (Doubleshot is a chance to score an additional hit with a ranged attack.)</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Keen\" title=\"Keen\">Keen</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Keen\" title=\"Keen\">Keen</a>:</b> Passive: The base critical <a href=\"/page/Threat_range\" title=\"Threat range\">threat range</a> of this weapon is doubled. This does not stack with <a href=\"/page/Improved_Critical\" title=\"Improved Critical\">Improved Critical</a> feat. <a href=\"/page/Vorpal_Strike\" title=\"Vorpal Strike\">Vorpal Strikes</a> by this weapon also bypass all <a href=\"/page/Fortification\" title=\"Fortification\">Fortification</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Improved_Paralyzing\" class=\"mw-redirect\" title=\"Improved Paralyzing\">Improved Paralyzing </a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Improved_Paralyzing\" class=\"mw-redirect\" title=\"Improved Paralyzing\">Improved Paralyzing </a>:</b> Any creature struck by this weapon must succeed on a DC 28 <a href=\"/page/Will_save\" title=\"Will save\">Will save</a> or be paralyzed. The target may attempt a new save to end the effect every several seconds; otherwise the paralysis lasts for 1 minute.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Slowburst\" title=\"Slowburst\">Improved Slowburst</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Slowburst\" title=\"Slowburst\">Improved Slowburst</a>:</b> This weapon has an image of a snail worked into its hilt or grip, and it feels cold to the touch. Whenever you score a critical hit with this weapon, the target is <a href=\"/page/Slow\" title=\"Slow\">slowed</a> for 30 seconds. A DC 28 <a href=\"/page/Will_save\" title=\"Will save\">Will save</a> negates this effect.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Vorpal#Improved_Vorpal\" title=\"Vorpal\"> Improved Vorpal</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Vorpal#Improved_Vorpal\" title=\"Vorpal\"> Improved Vorpal</a>:</b> Passive: <a href=\"/page/Weapon_dice_multiplier\" title=\"Weapon dice multiplier\">+0.5[W]</a> damage dice.<br />On <a href=\"/page/Vorpal_Strike\" title=\"Vorpal Strike\">Vorpal Hit</a>: If your target has fewer than 1500 Hit Points, they are instantly slain. If your target has above 1500 Hit Points, they take 150 damage.</span></span></li>\n<li><style data-mw-deduplicate=\"TemplateStyles:r705465\">.mw-parser-output span.popup.augment.orange>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Orange\"]{background-color:#F4A460;border-color:#0B5B9F}.mw-parser-output span.popup.augment.purple>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Purple\"]{background-color:#DDA0DD;border-color:#225F22}.mw-parser-output span.popup.augment.green>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Green\"]{background-color:#90EE90;border-color:#6F116F}.mw-parser-output span.popup.augment.yellow>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Yellow\"]{background-color:#EEE8AA;border-color:#111755}.mw-parser-output span.popup.augment.blue>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Blue\"]{background-color:#87CEFA;border-color:#783105}.mw-parser-output span.popup.augment.red>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Red\"]{background-color:#FA8072;border-color:#057F8D}.mw-parser-output span.popup.augment.colorless>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Colorless\"]{background-color:#F8F8FF;border-color:#070700}.mw-parser-output span.popup.augment.sun>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Sun\"]{background-color:#FFFFC0;border-color:#00003F}.mw-parser-output span.popup.augment.moon>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Moon\"]{background-color:#C0FFFF;border-color:#3F0000}.mw-parser-output span.popup.augment>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a{border:1px solid;border-radius:3px;padding:1px 3px}.mw-parser-output span.popup.augment>span.title>a{color:#003366}.mw-parser-output span.popup.augment>span.title>a:visited{color:#040050}.mw-parser-output span.popup.augment>s