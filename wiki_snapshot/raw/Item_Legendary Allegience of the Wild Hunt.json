put span.popup.augment>span.popup.tooltip>a[href*=\"Red\"]{background-color:#FA8072;border-color:#057F8D}.mw-parser-output span.popup.augment.colorless>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Colorless\"]{background-color:#F8F8FF;border-color:#070700}.mw-parser-output span.popup.augment.sun>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Sun\"]{background-color:#FFFFC0;border-color:#00003F}.mw-parser-output span.popup.augment.moon>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Moon\"]{background-color:#C0FFFF;border-color:#3F0000}.mw-parser-output span.popup.augment>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a{border:1px solid;border-radius:3px;padding:1px 3px}.mw-parser-output span.popup.augment>span.title>a{color:#003366}.mw-parser-output span.popup.augment>span.title>a:visited{color:#040050}.mw-parser-output span.popup.augment>span.tooltip::after{content:\" augments.\"}</style><span class=\"popup has&#95;tooltip with-icon augment green\"><span class=\"title\"><a href=\"/page/Augment_Slot\" title=\"Augment Slot\">Green Augment Slot</a></span><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><a href=\"/page/Category:Blue_augments\" title=\"Category:Blue augments\">Blue</a>, <a href=\"/page/Category:Green_augments\" title=\"Category:Green augments\">Green</a>, <a href=\"/page/Category:Yellow_augments\" title=\"Category:Yellow augments\">Yellow</a>, and <a href=\"/page/Category:Colorless_augments\" title=\"Category:Colorless augments\">Colorless</a></span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/pag