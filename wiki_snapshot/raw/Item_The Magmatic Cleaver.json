.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Stone\" title=\"Stone\">Stone</a>:</b> <b>Stone</b> items are very durable, but also very heavy. This is a material commonly used for bludgeoning weapons.</span></span> \n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Hardness\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">39\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Base Value\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><span style=\"display: none;\">0011602000</span>11,602<span class=\"popup has&#95;tooltip with-icon basic\">pp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Platinum Piece</a></span></span>&#160;\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">12 lbs\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><b><a href=\"/page/The_Dryad_and_the_Demigod\" title=\"The Dryad and the Demigod\">The Dryad and the Demigod</a></b>, Greater feytwisted chest\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+15 Enhancement Bonus</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+15 Enhancement Bonus</a>:</b> +15 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">enhancement bonus</a> to <a href=\"/page/Attack_roll\" title=\"Attack roll\">attack</a> and <a href=\"/page/Damage_roll\" title=\"Damage roll\">damage rolls</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Dripping_with_Magma\" title=\"Dripping with Magma\">Dripping with Magma</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Dripping_with_Magma\" title=\"Dripping with Magma\">Dripping with Magma</a>:</b> This Obsidian weapon drips with magma on every swing. Your attacks  have a high chance to deal very strong fire damage over time.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Keen\" title=\"Keen\">Keen</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Keen\" title=\"Keen\">Keen</a>:</b> Passive: The base critical <a href=\"/page/Threat_range\" title=\"Threat range\">threat range</a> of this weapon is doubled. This does not stack with <a href=\"/page/Improved_Critical\" title=\"Improved Critical\">Improved Critical</a> feat. <a href=\"/page/Vorpal_Strike\" title=\"Vorpal Strike\">Vorpal Strikes</a> by this weapon also bypass all <a href=\"/page/Fortification\" title=\"Fortification\">Fortification</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Armor-Piercing\" title=\"Armor-Piercing\"> Armor-Piercing 21%</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Armor-Piercing\" title=\"Armor-Piercing\"> Armor-Piercing 21%</a>:</b> Passive: +21% <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to <a href=\"/page/Fortification\" title=\"Fortification\">Fortification</a> Bypass. (Fortification Bypass makes your attacks ignore a percentage of enemy Fortification.)</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Flamebitten\" title=\"Flamebitten\">Flamebitten</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Flamebitten\" title=\"Flamebitten\">Flamebitten</a>:</b> On Hit: Applies a stack of <a href=\"/page/Vulnerable\" title=\"Vulnerable\">Vulnerable</a> (1% more damage for 3 seconds. This effect stacks up to 20 times, and loses one stack on expiration.). This effect may only occur on-hit once every two seconds.<br />On Vorpal: Applies a stack of <a href=\"/page/Ashscarred\" title=\"Ashscarred\">Ashscarred</a> (-1 to all Saving Throws. Non-bosses also move and attack 5% slower. This effect stacks up to 5 times.)</span></span></li>\n<li><style data-mw-deduplicate=\"TemplateStyles:r705465\">.mw-parser-output span.popup.augment.orange>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Orange\"]{background-color:#F4A460;border-color:#0B5B9F}.mw-parser-output span.popup.augment.purple>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Purple\"]{background-color:#DDA0DD;border-color:#225F22}.mw-parser-output span.popup.augment.green>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Green\"]{background-color:#90EE90;border-color:#6F116F}.mw-parser-output span.popup.augment.yellow>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Yellow\"]{background-color:#EEE8AA;border-color:#111755}.mw-parser-output span.popup.augment.blue>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Blue\"]{background-color:#87CEFA;border-color:#783105}.mw-parser-output span.popup.augment.red>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Red\"]{background-color:#FA8072;border-color:#057F8D}.mw-parser-output span.popup.augment.colorless>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Colorless\"]{background-color:#F8F8FF;border-color:#070700}.mw-parser-output span.popup.augment.sun>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Sun\"]{background-color:#FFFFC0;border-color:#00003F}.mw-parser-output span.popup.augment.moon>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Moon\"]{background-color:#C0FFFF;border-color:#3F00