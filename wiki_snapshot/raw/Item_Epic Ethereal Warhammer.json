ges.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Adamantine\" title=\"Adamantine\">Adamantine</a>:</b> Found only in meteorites and the rarest of veins in magical areas, this ultrahard metal adds to the quality of a weapon or suit of armor. Weapons made of adamantine have the ability to bypass the protective damage reduction of certain monsters.</span></span> \n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Hardness\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">40\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Base Value\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><span style=\"display: none;\">0008301200</span>8,301<span class=\"popup has&#95;tooltip with-icon basic\">pp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Platinum Piece</a></span></span>&#160;2<span class=\"popup has&#95;tooltip with-icon basic\">gp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Gold Piece</a></span></span>&#160;\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">5 lbs\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><b><a href=\"/page/Morten_Edgewright\" title=\"Morten Edgewright\">Morten Edgewright</a></b>, Turn in 1 <a href=\"/page/Item:Epic_Ethereal_Ingot\" title=\"Item:Epic Ethereal Ingot\">Epic Ethereal Ingot</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+6 Enhancement Bonus</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+6 Enhancement Bonus</a>:</b> +6 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">enhancement bonus</a> to <a href=\"/page/Attack_roll\" title=\"Attack roll\">attack</a> and <a href=\"/page/Damage_roll\" title=\"Damage roll\">damage rolls</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Impactful\" class=\"mw-redirect\" title=\"Impactful\">Impactful 4</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Impactful\" class=\"mw-redirect\" title=\"Impactful\">Impactful 4</a></b>: This effect causes the edges of this weapon to ripple with force, dealing 4 to 24 force on each hit.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Ghostbane\" title=\"Ghostbane\">Ghostbane 4</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Ghostbane\" title=\"Ghostbane\">Ghostbane 4</a>:</b> This weapon is attuned specifically to hunt the risen dead, dealing an additional 4d10 bane damage vs. <a href=\"/page/Undead\" class=\"mw-redirect\" title=\"Undead\">Undead</a> monsters.<br />Passive: This weapon has <a href=\"/page/Ghost_Touch\" title=\"Ghost Touch\">Ghost Touch</a>, and bypasses ethereal monster's 50% chance to evade bane damage.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Weaken_Undead\" title=\"Weaken Undead\">Weaken Undead</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Weaken_Undead\" title=\"Weaken Undead\">Weaken Undead</a>:</b> While wearing this item, your attacks cause <a href=\"/page/Undead\" class=\"mw-redirect\" title=\"Undead\">undead</a> creatures to lose 20% of their <a href=\"/page/Fortification\" title=\"Fortification\">Fortification</a> for the next 20 seconds. This effect does not stack with itself.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Adamantine\" title=\"Adamantine\">Adamantine</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Adamantine\" title=\"Adamantine\">Adamantine</a>:</b> Found only in meteorites and the rarest of veins in magical areas, this ultrahard metal adds to the quality of a weapon or suit of armor. Weapons made of adamantine have the ability to bypass the protective damage reduction of certain monsters.</span></span></li>\n<li><style data-mw-deduplicate=\"TemplateStyles:r705465\">.mw-parser-output span.popup.augment.orange>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Orange\"]{background-color:#F4A460;border-color:#0B5B9F}.mw-parser-output span.popup.augment.purple>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Purple\"]{background-color:#DDA0DD;border-color:#225F22}.mw-parser-output span.popup.augment.green>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Green\"]{background-color:#90EE90;border-color:#6F116F}.mw-parser-output span.popup.augment.yellow>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Yellow\"]{background-color:#EEE8AA;border-color:#111755}.mw-parser-output span.popup.augment.blue>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Blue\"]{background-color:#87CEFA;border-color:#783105}.mw-parser-output span.popup.augment.red>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Red\"]{background-color:#FA8072;border-color:#057F8D}.mw-parser-output span.popup.augment.colorless>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Colorless\"]{background-color:#F8F8FF;border-color:#070700}.mw-parser-output span.popup.augment.sun>span.title,.mw-