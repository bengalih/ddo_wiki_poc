  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><h2><span id=\"Epic_Roderic.27s_Wand\"></span><span class=\"mw-headline\" id=\"Epic_Roderic's_Wand\">Epic Roderic's Wand</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/edit/Template:Eternal_wand?section=T-1\" title=\"Edit section: Epic Roderic&#39;s Wand\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"border-color-1\" style=\"clear: right; border: 1px #DDF solid; margin: 4px; width: 95%; --bg-color-1:#DDDDFF;--bg-color-1-dark:#626474;--bg-color-2:#EEEEFF;--bg-color-2-dark:#515366;--border-color-1:#DDDDFF;--border-color-1-dark:#626474;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background: #DDF;\" width=\"20%\"><a href=\"/page/UMD\" class=\"mw-redirect\" title=\"UMD\">UMD</a> Difficulty\n</th>\n<td class=\"bg-color-2\" style=\"background: #EEF;\" width=\"50%\">55\n</td>\n<th class=\"bg-color-1\" style=\"background: #DDF;\" width=\"30%\" rowspan=\"10\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:SummonMonsterII.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/SummonMonsterII.png\" decoding=\"async\" width=\"60\" height=\"60\" class=\"mw-file-element\" /></a></span> <br /><a href=\"/page/Summon_Unknown_Monster_II\" title=\"Summon Unknown Monster II\">Summon Unknown Monster II</a><br />\n<p>Caster Level: 20<br />\n6/6 Charges<br />\nRecharged/Day: 6\n</p>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background: #DDF;\">No <a href=\"/page/UMD\" class=\"mw-redirect\" title=\"UMD\">UMD</a> check for:\n</th>\n<td class=\"bg-color-2\" style=\"background: #EEF;\">Wiz, Sor, Clr, FvS, Brd\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background: #DDF;\">Minimum Level:\n</th>\n<td class=\"bg-color-2\" style=\"background: #EEF;\">20\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background: #DDF;\">Binding\n</th>\n<td class=\"bg-col