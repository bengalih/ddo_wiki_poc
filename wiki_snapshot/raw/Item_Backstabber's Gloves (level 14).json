ut span.popup.has_tooltip:hover>span.popup.tooltip.left{left:0px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center{left:50%;margin-left:-125px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.narrow{margin-left:-50px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.fill{left:-262px;margin-left:auto;margin-right:auto;right:-262px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.wide{margin-left:-225px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.right{left:auto;right:0px}</style><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Leather\" title=\"Leather\">Leather</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Leather\" title=\"Leather\">Leather</a>:</b> <b>Leather</b> armor is made of the hide of animals. It provides decent protection without excessively restricting the user's movements.</span></span> \n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Hardness\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">24\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF; width: 150px;\">Base Value\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF; width: 450px;\"><span style=\"display: none;\">0005620000</span>5,620<span class=\"popup has&#95;tooltip with-icon basic\">pp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Platinum Piece</a></span></span>&#160;\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">0.10 lbs\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\"><b><a href=\"/page/The_Crucible\" title=\"The Crucible\">The Crucible</a></b>, <a href=\"/page/Harza_Ghost_Waker\" class=\"mw-redirect\" title=\"Harza Ghost Waker\">Harza Ghost Waker</a>'s chest (Heroic Elite)\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Bluff\" title=\"Bluff\">Bluff +13</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Bluff\" title=\"Bluff\">Bluff +13</a>:</b> Passive: +13 <a href=\"/page/Competence_bonus\" title=\"Competence bonus\">Competence bonus</a> to the <a href=\"/page/Bluff\" title=\"Bluff\">Bluff</a> skill.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Sneak_Attack_Bonus\" class=\"mw-redirect\" title=\"Sneak Attack Bonus\">  Sneak Attack Bonus +4</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Sneak_Attack_Bonus\" class=\"mw-redirect\" title=\"Sneak Attack Bonus\">  Sneak Attack Bonus +4</a></b>&#160;: Provides a +4 Enhancement modifier to your attack bonus and a +6 Enhancement bonus to damage for any attack that would qualify as a Sneak Attack, even if the wielder is not a Rogue.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Deception\" title=\"Deception\">Deception</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Deception\" title=\"Deception\">Deception</a>:</b> This weapon is hard to focus upon and thus provides a +3 enhancement bonus to Bluff checks. In addition, Deception weapons have a small chance to envelop the target in darkness, making them vulnerable to sneak attacks for a short time.</span></span></li>\n<li><style data-mw-deduplicate=\"TemplateStyles:r705465\">.mw-parser-output span.popup.augment.orange>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Orange\"]{background-color:#F4A460;border-color:#0B5B9F}.mw-parser-output span.popup.augment.purple>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Purple\"]{background-color:#DDA0DD;border-color:#225F22}.mw-parser-output span.popup.augment.green>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Green\"]{background-color:#90EE90;border-color:#6F116F}.mw-parser-output span.popup.augment.yellow>span.title,.mw-parser-output span.popup.augmen