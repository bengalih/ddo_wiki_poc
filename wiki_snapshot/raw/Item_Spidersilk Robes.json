  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><p><i>This item is not to be confused with the level 6 item <a href=\"/page/Item:Spider_Silk_Robe\" title=\"Item:Spider Silk Robe\">Spider Silk Robe</a>.</i>\n</p>\n<h2><span class=\"mw-headline\" id=\"Spidersilk_Robes\">Spidersilk Robes</span></h2>\n<table style=\"clear: right; border: 1px solid #FFD700; padding: 4px; width: 100%; --bg-color-1:#DDBB00;--bg-color-1-dark:#635400;--bg-color-2:#FFFACD;--bg-color-2-dark:#433E14;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\" width=\"15%\">Armor Type\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\" width=\"42.5%\">Robe\n</td>\n<th class=\"bg-color-2\" rowspan=\"15\" style=\"background:#FFFACD;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Spidersilk_Robes_shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Spidersilk_Robes_shown.jpg/420px-Spidersilk_Robes_shown.jpg\" decoding=\"async\" width=\"420\" height=\"274\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/thumb/Spidersilk_Robes_shown.jpg/630px-Spidersilk_Robes_shown.jpg 1.5x, https://images.ddowiki.com/thumb/Spidersilk_Robes_shown.jpg/840px-Spidersilk_Robes_shown.jpg 2x\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Feat Requirement\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\">None\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Race Absolutely Excluded\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\"><a href=\"/page/Warforged\" title=\"Warforged\">Warforged</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #F0DC82;\">Minimum Level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #FFFACD;\">22\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\"><a