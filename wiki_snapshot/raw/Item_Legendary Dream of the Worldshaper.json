hover>span.popup.tooltip.below{bottom:auto;top:100%;margin-top:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.left{left:0px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center{left:50%;margin-left:-125px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.narrow{margin-left:-50px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.fill{left:-262px;margin-left:auto;margin-right:auto;right:-262px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.wide{margin-left:-225px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.right{left:auto;right:0px}</style><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Cloth\" title=\"Cloth\">Cloth</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Cloth\" title=\"Cloth\">Cloth</a>:</b> <b>Cloth</b> is a very common material used in <a href=\"/page/Handwraps\" class=\"mw-redirect\" title=\"Handwraps\">handwraps</a>, <a href=\"/page/Category:Cloth_armor\" title=\"Category:Cloth armor\">robes, outfits</a>. and other <a href=\"/page/Accessories\" class=\"mw-redirect\" title=\"Accessories\">accessories</a>.</span></span> \n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Hardness\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">55\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF; width: 150px;\">Base Value\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF; width: 450px;\"><span style=\"display: none;\">0014001000</span>14,001<span class=\"popup has&#95;tooltip with-icon basic\">pp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Platinum Piece</a></span></span>&#160;\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">0.10 lbs\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\"><b><a href=\"/page/Catalyst_Crafting\" title=\"Catalyst Crafting\">Catalyst Crafting</a></b>, Turn in <a href=\"/page/Item:Mantle_of_the_Worldshaper\" title=\"Item:Mantle of the Worldshaper\">Mantle of the Worldshaper</a>, its Legendary <a href=\"/page/Deep_Catalyst\" class=\"mw-redirect\" title=\"Deep Catalyst\">Deep Catalyst</a> and 5 <a href=\"/page/Item:Legendary_Abyssal_Gem\" class=\"mw-redirect\" title=\"Item:Legendary Abyssal Gem\">Legendary Abyssal Gems</a> at the <a href=\"/page/Strange_Catalyst_Forge\" class=\"mw-redirect\" title=\"Strange Catalyst Forge\">Strange Catalyst Forge</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Heroic_Inspiration\" title=\"Heroic Inspiration\">Heroic Inspiration</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Heroic_Inspiration\" title=\"Heroic Inspiration\">Heroic Inspiration</a>:</b> This item inspires you to acts of great heroism, granting a +5% bonus to <a href=\"/page/Experience_point\" title=\"Experience point\">experience points</a> granted by completing quests while it is equipped. This stacks with experience boosting effects from <a href=\"/page/Item:Experience_Elixir\" title=\"Item:Experience Elixir\">elixirs</a> but does not stack with experience boosting effects from other equippable items.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Spell_Absorption\" title=\"Spell Absorption\">Spell Absorption</a> - 20 Charges (Recharged/Day: 5)<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Spell_Absorption\" title=\"Spell Absorption\">Spell Absorption</a>:</b> This effect absorbs harmful spells targeted at the wearer.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Nullmagic_Guard\" title=\"Nullmagic Guard\">Nullmagic&#32;Guard</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Nullmagic_Guard\" title=\"Nullmagic Guard\">Nullmagic&#32;Guard</a>:</b> On being hit with a spell: There is a small chance that you explode in arcane energies. Foes hit are subject to a silencing effect, preventing their spellcasts and dampening their magical protections for 10 seconds.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Saving_throw\" title=\"Saving throw\"> Spell Save +13</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Saving_throw\" title=\"Saving throw\"> Spell Save +13</a>:</b> This item gives a +13 <a href=\"/page/Resistance_bonus\" title=\"Resistance bonus\">Resistance bonus</a> to your saves versus spells.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Strength_of_Purpose\" title=\"Strength of Purpose\">Strength of Purpose</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Strength_of_Purpose\" title=\"Strength of Purpose\">Strength of Purpose</a>:</b> You gain a +128 Enhancement Bonus to <a href=\"/page/Unconscious\" title=\"Unconscious\">Unconsciousness Range</a>, and regenerate 16 Hit Points using Positive Healing every 10 seconds.</span></span></li>\n<li><style data-mw-deduplicate=\"TemplateStyles:r705465\">.mw-parser-output span.popup.augment.orange>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Orange\"]{background-color:#F4A460;border-color:#0B5B9F}.mw-parser-output span.popup.augment.purple>spa