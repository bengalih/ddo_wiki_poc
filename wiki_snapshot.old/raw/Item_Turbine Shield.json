  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><table style=\"text-align: center; background-color: #D9D9FF; background-color: rgba(0, 0, 255, 0.15); border: 1px #4A4ABA solid; margin: 0.25em; padding: 0.20em; width: 100%;\">\n\n<tbody><tr style=\"font-size: 1.5em;\">\n<td rowspan=\"3\" style=\"vertical-align: middle; width: 60px;\"><figure class=\"mw-halign-center\" typeof=\"mw:File/Frameless\"><a href=\"/page/File:History_shield-book-sword.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/40px-History_shield-book-sword.png\" decoding=\"async\" width=\"40\" height=\"57\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/60px-History_shield-book-sword.png 1.5x, https://images.ddowiki.com/thumb/History_shield-book-sword.png/80px-History_shield-book-sword.png 2x\" /></a><figcaption></figcaption></figure>\n</td>\n<th><a href=\"/page/Category:History\" title=\"Category:History\">History</a>\n</th>\n<td rowspan=\"3\" style=\"vertical-align: middle; width: 60px;\"><figure class=\"mw-halign-center\" typeof=\"mw:File/Frameless\"><a href=\"/page/File:History_shield-book-sword.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/40px-History_shield-book-sword.png\" decoding=\"async\" width=\"40\" height=\"57\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/60px-History_shield-book-sword.png 1.5x, https://images.ddowiki.com/thumb/History_shield-book-sword.png/80px-History_shield-book-sword.png 2x\" /></a><figcaption></figcaption></figure>\n</td></tr>\n<tr style=\"font-size: 1.2em;\">\n<td><i>This page is about an item that no longer drops in-game.</i>\n</td></tr>\n<tr style=\"font-size: 0.8em;\">\n<td>If you can verify that the item still drops, please <span class=\"plainlinks\"><a class=\"external text\" href=\"https://ddowiki.com/index.php?title=Item:Turbine_Shield&amp;action=edit#editform\"><span class=\"edit-link\" style=\"display: inherit;\" title=\"edit this page\">edit this page</span></a></span> and remove this template.\n</td></tr></tbody></table>\n<h2><span class=\"mw-headline\" id=\"\"></span></h2>\n<table class=\"border-color-1\" style=\"clear: right; border: 1px #AACCFF solid; margin: 4px; width: 100%; --bg-color-1:#AACCFF;--bg-color-1-dark:#244e8b;--bg-color-2:#CCEEFF;--bg-color-2-dark:#0f3e57;--border-color-1:#AACCFF;--border-color-1-dark:#33578C;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\" width=\"15%\">Shield Type\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\" width=\"42.5%\">Large Shield\n</td>\n<th class=\"bg-color-2\" rowspan=\"16\" style=\"background:#CCEEFF\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Turbine_Shield_shown.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/Turbine_Shield_shown.png\" decoding=\"async\" width=\"420\" height=\"456\" class=\"mw-file-element\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Proficiency\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\"><a href=\"/page/Shield_Proficiency_(General)\" title=\"Shield Proficiency (General)\">Shield Proficiency (General)</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Minimum Level\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\">None\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Required Trait\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\">None\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Attack Mod\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\">STR\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Damage Mod\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\">STR\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\"><a href=\"/page/Bind\" title=\"Bind\">Unbound</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Shield Bonus\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\">+2\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Max Dex Bonus\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\">None\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\"><a href=\"/page/Damage_Reduction\" title=\"Damage Reduction\">Damage Reduction</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\">2\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\"><a href=\"/page/Armor_Check_Penalty\" class=\"mw-redirect\" title=\"Armor Check Penalty\">Armor Check Penalty</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\">0\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\"><a href=\"/page/Arcane_spell_failure\" title=\"Arcane spell failure\">Arcane Spell Failure</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\">0%\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\"><a href=\"/page/Damage\" title=\"Damage\">Damage</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\">[1d6] + 0 Bludgeon\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Critical Roll\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\">20 / x2\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\">500\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Material\n</th>\n<td class=\"b