  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><figure class=\"mw-halign-left\" typeof=\"mw:File/Frameless\"><a href=\"/page/Category:Quiver_items\" title=\"Category:Quiver items\"><img src=\"https://images.ddowiki.com/Icon_Item_Slot_Quiver.png\" decoding=\"async\" width=\"32\" height=\"32\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure> \n<h2><span class=\"mw-headline\" id=\"Quiver_of_Poison\">Quiver of Poison</span></h2>\n<p><span style=\"background-color: initial; color: #FF0000;\"><span style=\"font-size: larger; font-weight: inherit;\"><i>This item cannot be fed to <a href=\"/page/Sentient_Weapon\" title=\"Sentient Weapon\">sentient jewels</a>.</i></span></span>\n</p>\n<table class=\"border-color-1\" style=\"clear: right; margin: 4px; border: 1px solid #EEBBEE; --bg-color-1:#DDA0DD;--bg-color-1-dark:#773777;--bg-color-2:#FFC2FF;--bg-color-2-dark:#4B224B;--border-color-1:#DDA0DD;--border-color-1-dark:#773777;\" width=\"100%\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background-color:#EEBBEE\" width=\"15%\">Minimum level\n</th>\n<td class=\"bg-color-2\" style=\"background-color:#F0E4F0\" width=\"50%\">23\n</td>\n<th rowspan=\"11\" class=\"bg-color-2\" style=\"background:#F0E4F0\" width=\"35%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Quiver_Generic_Large_Thin.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/Quiver_Generic_Large_Thin.png\" decoding=\"async\" width=\"420\" height=\"398\" class=\"mw-file-element\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color:#EEBBEE\">Item Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color:#F0E4F0\">Quiver / Thin Quiver\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color:#EEBBEE\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background-color:#F0E4F0\"><a href=\"/page/Bind\" title=\"Bind\">Bound to Character&#160;on Acquire</a>\n</td></tr>\n<tr>\n<th clas