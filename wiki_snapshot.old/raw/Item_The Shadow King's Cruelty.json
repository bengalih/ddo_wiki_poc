  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><h2><span id=\"The_Shadow_King.27s_Cruelty\"></span><span class=\"mw-headline\" id=\"The_Shadow_King's_Cruelty\">The Shadow King's Cruelty</span></h2>\n<table style=\"clear: right; border: 1px solid #FFD700; padding: 4px; width: 100%; --bg-color-1:#DDBB00;--bg-color-1-dark:#635400;--bg-color-2:#FFFACD;--bg-color-2-dark:#433E14;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\" width=\"15%\">Armor Type\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\" width=\"42.5%\">Light Armor\n</td>\n<th class=\"bg-color-2\" rowspan=\"15\" style=\"background:#FFFACD;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:The_Shadow_King%27s_Cruelty_shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/The_Shadow_King%27s_Cruelty_shown.jpg/420px-The_Shadow_King%27s_Cruelty_shown.jpg\" decoding=\"async\" width=\"420\" height=\"549\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/The_Shadow_King%27s_Cruelty_shown.jpg 1.5x\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Feat Requirement\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\">Light Armor Proficiency\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Race Absolutely Excluded\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\"><a href=\"/page/Warforged\" title=\"Warforged\">Warforged</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #F0DC82;\">Minimum Level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #FFFACD;\">11\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\"><a href=\"/page/Bind\" title=\"Bind\">Bound to Account&#160;on Acquire</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\"><a href=\"/page/Armor_bonus\" title=\"Armor bonus\">Armor Bonus</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\">14\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Maximum Dexterity Bonus\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\">6\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\"><a href=\"/page/Armor_check_penalty\" title=\"Armor check penalty\">Armor Check Penalty</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\">0\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\"><a href=\"/page/Arcane_spell_failure\" title=\"Arcane spell failure\">Arcane Spell Failure</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\">10%\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\">182\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Material\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\"><style data-mw-deduplicate=\"TemplateStyles:r705484\">.mw-parser-output span.popup.has_tooltip{cursor:pointer;position:relative}.mw-parser-output span.popup.has_tooltip.no-icon{border-bottom:1px dashed #999999}.mw-parser-output span.popup.has_tooltip>span.popup.tooltip{background-color:#EEEEEE;background-color:var(--background-color-neutral,#EEEEEE);border:1px solid #333333;border-radius:3px;box-shadow:3px 5px 10px;color:#202122;color:var(--color-base,#202122);cursor:text;display:none;margin:0px;max-width:500px;padding:5px;width:250px;z-index:10000}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.narrow{width:100px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.fill{padding:5px 12px;width:max-content}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.wide{width:450px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.custom{max-width:80vw}.mw-parser-output span.popup.has_tooltip:hover>span