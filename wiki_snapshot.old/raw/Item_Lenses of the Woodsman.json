  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><figure class=\"mw-halign-left\" typeof=\"mw:File/Frameless\"><a href=\"/page/Category:Eye_items\" title=\"Category:Eye items\"><img src=\"https://images.ddowiki.com/Icon_ItemSlot_Eye.png\" decoding=\"async\" width=\"32\" height=\"32\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure> \n<h2><span class=\"mw-headline\" id=\"Lenses_of_the_Woodsman\">Lenses of the Woodsman</span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #FFBBBB solid; margin: 4px; width: 100%; --bg-color-1:#FFBBBB;--bg-color-1-dark:#573F3F;--bg-color-2:#FFE4E1;--bg-color-2-dark:#3D2C2A;--header-color:#FFBBBB;--header-color-dark:#573F3F;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\" width=\"15%\">Minimum level\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\" width=\"42.5%\">20\n</td>\n<th rowspan=\"11\" class=\"bg-color-2\" style=\"background:#FFE4E1\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Lenses_of_the_Woodsman_Shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Lenses_of_the_Woodsman_Shown.jpg/420px-Lenses_of_the_Woodsman_Shown.jpg\" decoding=\"async\" width=\"420\" height=\"382\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/thumb/Lenses_of_the_Woodsman_Shown.jpg/630px-Lenses_of_the_Woodsman_Shown.jpg 1.5x, https://images.ddowiki.com/Lenses_of_the_Woodsman_Shown.jpg 2x\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Item Type\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">Jewelry / Goggles\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\"><a href=\"/page/Slot\" class=\"mw-redirect\" title=\"Slot\">Slot</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">Eye\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><a href=\"/page/Bind\" title=\"Bind\">Bound to Character&#160;on Acquire</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">210\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Material\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><style data-mw-deduplicate=\"TemplateStyles:r705484\">.mw-parser-output span.popup.has_tooltip{cursor:pointer;position:relative}.mw-parser-output span.popup.has_tooltip.no-icon{border-bottom:1px dashed #999999}.mw-parser-output span.popup.has_tooltip>span.popup.tooltip{background-color:#EEEEEE;background-color:var(--background-color-neutral,#EEEEEE);border:1px solid #333333;border-radius:3px;box-shadow:3px 5px 10px;color:#202122;color:var(--color-base,#202122);cursor:text;display:none;margin:0px;max-width:500px;padding:5px;width:250px;z-index:10000}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.narrow{width:100px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.fill{padding:5px 12px;width:max-content}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.wide{width:450px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.custom{max-width:80vw}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip{display:block;position:absolute}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.above{bottom:100%;top:auto;margin-bottom:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.middle{bottom:auto;top:50%;margin-top:-1em}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.below{bottom:auto;top:100%;margin-top:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.left{left:0px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center{left:50%;margin-left:-125px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.narrow{margin-left:-50px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.fill{left:-262px;margin-left:auto;margin-right:auto;right:-262px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.wide{margin-left:-225px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.right{left:auto;right:0px}</style><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Glass\" title=\"Glass\">Glass</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Glass\" title=\"Glass\">Glass</a>:</b> Items made of <b>glass</b> are immune to damage from contact with ooze.</span></span> \n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Hardness\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">22\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\" width=\"150\">Base Value\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\" width=\"450\"><span style=\"display: none;\">0008020000</span>8,020<span class=\"popup has&#95;tooltip with-icon basic\">pp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Platinum Piece</a></span></span>&#160;\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">0.10 lbs\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><b><a href=\"/page/Eveningstar\" title=\"Eveningstar\">Eveningstar</a></b>, Turn in 5&#32;<span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Item:Commendation:_Druids_of_the_King%27s_Forest\" title=\"Item:Commendation: Druids of the King&#39;s Forest\">Commendations: Druids of the King's Forest</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Item:Commendation:_Druids_of_the_King%27s_Forest\" title=\"Item:Commendation: Druids of the King&#39;s Forest\">Commendation: Druids of the King's Forest</a>:</b> This is a valuable item that can be exchanged for goods if brought to a Challenge Trader. This is a token of favor earned by helping the Druids of the King's Forest. You can exchange it in <a href=\"/page/Eveningstar\" title=\"Eveningstar\">Eveningstar</a> for powerful equipment.</span></span>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/True_Seeing_(enchantment)\" title=\"True Seeing (enchantment)\">True Seeing</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/True_Seeing_(enchantment)\" title=\"True Seeing (enchantment)\">True Seeing</a>:</b> Passive: You gain the benefit of the spell <a href=\"/page/True_Seeing_(spell)\" title=\"True Seeing (spell)\">True Seeing</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Attack_bonus\" title=\"Attack bonus\">Attack Bonus +3</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Attack_bonus\" title=\"Attack bonus\">Attack Bonus +3</a>:</b> Provides a +3 <a href=\"/page/Competence_bonus\" title=\"Competence bonus\">competence bonus</a> to your <a href=\"/page/Attack_roll\" title=\"Attack roll\">attack rolls</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Seeker\" title=\"Seeker\"> Seeker +6</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Seeker\" title=\"Seeker\"> Seeker +6</a>:</b> Provides a +6 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to confirm critical hits, and a +6 Enhancement bonus to critical hit damage (before multipliers are applied).</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Named_item_sets#Woodsman&#39;s_Guile\" title=\"Named item sets\">Woodsman's Guile</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Named_item_sets#Woodsman&#39;s_Guile\" title=\"Named item sets\">Woodsman's Guile</a>:</b> When all three items from the set are equipped, you will gain a +4 bonus to your To-Hit and +6 bonus to your Damage on any attack that would be considered a Sneak Attack.</span></span></li></ul>\n</td>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1; vertical-align: middle;\" rowspan=\"4\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Lenses_of_the_Woodsman.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Lenses_of_the_Woodsman.png/420px-Lenses_of_the_Woodsman.png\" decoding=\"async\" width=\"420\" height=\"365\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Lenses_of_the_Woodsman.png 1.5x\" /></a></span>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Upgradeable?\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Description\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><i>These lenses have been enchanted to allow sight in even the darkest conditions.</i>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Tips\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">\n<p><br />\n</p>\n</td></tr></tbody></table>\n<!-- \nNewPP limit report\nCached time: 20260816180843\nCache expiry: 86400\nReduced expiry: false\nComp