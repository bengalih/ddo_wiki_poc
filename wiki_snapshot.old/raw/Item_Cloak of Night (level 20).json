  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><figure class=\"mw-halign-left\" typeof=\"mw:File/Frameless\"><a href=\"/page/Category:Back_items\" title=\"Category:Back items\"><img src=\"https://images.ddowiki.com/Icon_ItemSlot_Back.png\" decoding=\"async\" width=\"32\" height=\"32\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure> \n<h2><span class=\"mw-headline\" id=\"Cloak_of_Night\"><a href=\"/page/Item:Cloak_of_Night\" class=\"mw-redirect\" title=\"Item:Cloak of Night\">Cloak of Night</a></span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #DDAAFF solid; margin: 4px; width: 100%; --bg-color-1:#DDA0DD;--bg-color-1-dark:#773777;--bg-color-2:#EEDDFF;--bg-color-2-dark:#3A2F45;--header-color:#DDA0DD;--header-color-dark:#773777;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\" width=\"15%\">Minimum level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\" width=\"42.5%\">20\n</td>\n<th rowspan=\"11\" class=\"bg-color-2\" style=\"background-color: #EEDDFF;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Cloak_of_Night_shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/Cloak_of_Night_shown.jpg\" decoding=\"async\" width=\"420\" height=\"806\" class=\"mw-file-element\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Item Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">Clothing / Cloak\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\"><a href=\"/page/Slot\" class=\"mw-redirect\" title=\"Slot\">Slot</a>\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">Back\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\"><a href=\"/page/None\" title=\"None\"