  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><table style=\"text-align: center; background-color: #D9D9FF; background-color: rgba(0, 0, 255, 0.15); border: 1px #4A4ABA solid; margin: 0.25em; padding: 0.20em; width: 100%;\">\n\n<tbody><tr style=\"font-size: 1.5em;\">\n<td rowspan=\"3\" style=\"vertical-align: middle; width: 60px;\"><figure class=\"mw-halign-center\" typeof=\"mw:File/Frameless\"><a href=\"/page/File:History_shield-book-sword.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/40px-History_shield-book-sword.png\" decoding=\"async\" width=\"40\" height=\"57\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/60px-History_shield-book-sword.png 1.5x, https://images.ddowiki.com/thumb/History_shield-book-sword.png/80px-History_shield-book-sword.png 2x\" /></a><figcaption></figcaption></figure>\n</td>\n<th><a href=\"/page/Category:History\" title=\"Category:History\">History</a>\n</th>\n<td rowspan=\"3\" style=\"vertical-align: middle; width: 60px;\"><figure class=\"mw-halign-center\" typeof=\"mw:File/Frameless\"><a href=\"/page/File:History_shield-book-sword.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/40px-History_shield-book-sword.png\" decoding=\"async\" width=\"40\" height=\"57\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/60px-History_shield-book-sword.png 1.5x, https://images.ddowiki.com/thumb/History_shield-book-sword.png/80px-History_shield-book-sword.png 2x\" /></a><figcaption></figcaption></figure>\n</td></tr>\n<tr style=\"font-size: 1.2em;\">\n<td><i>This page is about an item that no longer drops in-game.</i>\n</td></tr>\n<tr style=\"font-size: 0.8em;\">\n<td>If you can verify that the item still drops, please <span class=\"plainlinks\"><a class=\"external text\" href=\"https://ddowiki.co