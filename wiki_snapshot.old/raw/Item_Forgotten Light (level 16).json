owiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Radiance_(spell_boost)\" title=\"Radiance (spell boost)\">Radiance +78</a>:</b> Passive: +78 <a href=\"/page/Equipment_bonus\" title=\"Equipment bonus\">Equipment bonus</a> to Light and Alignment <a href=\"/page/Spell_Power\" title=\"Spell Power\">Spell Power</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Mythic_Boost\" title=\"Mythic Boost\">Mythic Weapon Boost</a> +2 or +4<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Mythic_Boost\" title=\"Mythic Boost\">Mythic Weapon Boost</a> +2 or +4:</b> +2 or +4 <a href=\"/page/Mythic_bonus\" title=\"Mythic bonus\">Mythic bonus</a> to <a href=\"/page/Melee_Power\" title=\"Melee Power\">Melee</a>, <a href=\"/page/Ranged_Power\" title=\"Ranged Power\">Ranged</a>, and <a href=\"/page/Universal_Spell_Power\" title=\"Universal Spell Power\">Universal Spell Power</a>.<br />(<i>This is a rare enchantment that does not show up on all drops of this item.</i>)</span></span></li></ul>\n</td>\n<td class=\"bg-color-2\" style=\"background:#EFC; vertical-align: middle;\" rowspan=\"4\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Forgotten_Light_(Level_16).png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Forgotten_Light_%28Level_16%29.png/420px-Forgotten_Light_%28Level_16%29.png\" decoding=\"async\" width=\"420\" height=\"518\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Forgotten_Light_%28Level_16%29.png 1.5x\" /></a></span>\n</td></tr>\n<tr>\n<th cl