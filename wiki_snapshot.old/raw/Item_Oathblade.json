  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><h2><span class=\"mw-headline\" id=\"Oathblade\">Oathblade</span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #CCFF99 solid; margin: 4px; width: 100%; --bg-color-1:#CCFF99;--bg-color-1-dark:#3D5F1A;--bg-color-2:#EEFFCC;--bg-color-2-dark:#272F17;--header-color:#CCFF99;--header-color-dark:#3D5F1A;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99; width: 15%;\">Proficiency Class\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC; width: 42.5%;\">Martial Weapon Proficiency\n</td>\n<th class=\"bg-color-2\" rowspan=\"19\" style=\"background:#EEFFCC;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Oathblade_shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Oathblade_shown.jpg/420px-Oathblade_shown.jpg\" decoding=\"async\" width=\"420\" height=\"575\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Oathblade_shown.jpg 1.5x\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Accepts Sentience?\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">Yes\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Damage and Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">3.50[1d10] + 6 Slash, Lawful, Magic\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\"><a href=\"/page/Threat_range\" title=\"Threat range\">Critical threat range</a>\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">15-20 / x2\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Weapon Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\"><b><a href=\"/page/Long_Sword\" title=\"Long Sword\">Long Sword</a></b> / Slashing weapons\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Minimum Level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">20\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Required Trait\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">Lawful\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\"><a href=\"/page/Use_Magical_Device\" class=\"mw-redirect\" title=\"Use Magical Device\">Use Magical Device</a> <a href=\"/page/DC\" class=\"mw-redirect\" title=\"DC\">DC</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">26\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Handedness\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Attack Mod\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">STR\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Damage Mod\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">STR\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><a href=\"/page/Bind\" title=\"Bind\">Bound to Character&#160;on Acquire</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">270\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Made from\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><style data-mw-deduplicate=\"TemplateStyles:r705484\">.mw-parser-output span.popup.has_tooltip{cursor:pointer;position:relative}.mw-parser-output span.popup.has_tooltip.no-icon{border-bottom:1px dashed #999999}.mw-parser-output span.popup.has_tooltip>span.popup.tooltip{background-color:#EEEEEE;backgr