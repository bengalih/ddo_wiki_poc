  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><h2><span class=\"mw-headline\" id=\"Legendary_Splintermast\">Legendary Splintermast</span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #CCFF99 solid; margin: 4px; width: 100%; --bg-color-1:#CCFF99;--bg-color-1-dark:#3D5F1A;--bg-color-2:#EEFFCC;--bg-color-2-dark:#272F17;--header-color:#CCFF99;--header-color-dark:#3D5F1A;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99; width: 15%;\">Proficiency Class\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC; width: 42.5%;\">Simple Weapon Proficiency\n</td>\n<th class=\"bg-color-2\" rowspan=\"19\" style=\"background:#EEFFCC;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Splintermast_shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Splintermast_shown.jpg/420px-Splintermast_shown.jpg\" decoding=\"async\" width=\"420\" height=\"426\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Splintermast_shown.jpg 1.5x\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Accepts Sentience?\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">Yes\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Damage and Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">5[1d4+2] + 15 Pierce, Magic\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\"><a href=\"/page/Threat_range\" title=\"Threat range\">Critical threat range</a>\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">20 / x2\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Weapon Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\"><b><a href=\"/page/Dart\" title=\"Dart\">Dart</a></b> / Thrown weapons\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" sty