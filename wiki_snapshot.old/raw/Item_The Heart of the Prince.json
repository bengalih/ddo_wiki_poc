  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><h2><span class=\"mw-headline\" id=\"The_Heart_of_the_Prince\">The Heart of the Prince</span></h2>\n<table class=\"border-color-1\" style=\"clear: right; border: 1px #AACCFF solid; margin: 4px; width: 100%; --bg-color-1:#AACCFF;--bg-color-1-dark:#244e8b;--bg-color-2:#CCEEFF;--bg-color-2-dark:#0f3e57;--border-color-1:#AACCFF;--border-color-1-dark:#33578C;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\" width=\"15%\">Shield Type\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\" width=\"42.5%\">Orb\n</td>\n<th class=\"bg-color-2\" rowspan=\"12\" style=\"background:#CCEEFF\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:The_Heart_of_the_Prince_Shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/The_Heart_of_the_Prince_Shown.jpg\" decoding=\"async\" width=\"420\" height=\"400\" class=\"mw-file-element\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Proficiency\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\"><a href=\"/page/Magical_Training\" title=\"Magical Training\">Magical Training</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Minimum Level\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\">29\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Required Trait\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\">None\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Attack Mod\n</th>\n<td class=\"bg-color-2\" style=\"background:#CCEEFF\">INT\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#AACCFF\">Damage Mod\n</th>\n<td class=