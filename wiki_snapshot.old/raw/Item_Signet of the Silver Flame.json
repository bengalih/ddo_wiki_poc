arrow{margin-left:-50px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.fill{left:-262px;margin-left:auto;margin-right:auto;right:-262px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.wide{margin-left:-225px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.right{left:auto;right:0px}</style><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Gold\" class=\"mw-redirect\" title=\"Gold\">Gold</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Gold\" class=\"mw-redirect\" title=\"Gold\">Gold</a>:</b> <b>Gold</b> is an expensive precious metal often used in jewellery. Unfortunately, it is very fragile, and often has low hardness.</span></span> \n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Hardness\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">9\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\" width=\"150\">Base Value\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\" width=\"450\"><span style=\"display: none;\">0003620000</span>3,620<span class=\"popup has&#95;tooltip with-icon basic\">pp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Platinum Piece</a></span></span>&#160;\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">0.10 lbs\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><b><a href=\"/page/Necropolis\" class=\"mw-redirect\" title=\"Necropolis\">Necropolis</a></b>, Turn in <a href=\"/page/Dark_Scarab_Powder\" class=\"mw-redirect\" title=\"Dark Scarab Powder\">Dark Scarab Powder</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Undead_Guard\" title=\"Undead Guard\">Undead&#32;Guard</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Undead_Guard\" title=\"Undead Guard\">Undead&#32;Guard</a>:</b> This armor burns those Undead that attack the wearer, causing 3d8 Good damage on a successful melee attack.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Intelligence\" title=\"Intelligence\"> Intelligence +4</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Intelligence\" title=\"Intelligence\"> Intelligence +4</a></b>: This item focuses the power of the wearer's mind, granting a +4 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Intelligence.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Charisma\" title=\"Charisma\"> Charisma +4</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Charisma\" title=\"Charisma\"> Charisma +4</a></b>: This item makes the wearer have more flair, granting a +4 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Charisma.</span></span></li></ul>\n</td>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1; vertical-align: middle;\" rowspan=\"4\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Signet_of_the_Silver_Flame.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Signet_of_the_Silver_Flame.png/420px-Signet_of_the_Silver_Flame.png\" decoding=\"async\" width=\"420\" height=\"288\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Signet_of_the_Silver_Flame.png 1.5x\" /></a></span>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Upgradeable?\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Description\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><i>This ring is enscribed with a series of arcane runes interwoven with symbols of the Silver Flame.</i>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Tips\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">\n<p><br />\n</p>\n</td></tr></tbody></table>\n<!-- \nNewPP limit report\nCached time: 20260817061736\nCache expiry: 86400\nReduced expiry