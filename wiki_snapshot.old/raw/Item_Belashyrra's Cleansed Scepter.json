  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><h2><span id=\"Belashyrra.27s_Cleansed_Scepter\"></span><span class=\"mw-headline\" id=\"Belashyrra's_Cleansed_Scepter\">Belashyrra's Cleansed Scepter</span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #CCFF99 solid; margin: 4px; width: 100%; --bg-color-1:#CCFF99;--bg-color-1-dark:#3D5F1A;--bg-color-2:#EEFFCC;--bg-color-2-dark:#272F17;--header-color:#CCFF99;--header-color-dark:#3D5F1A;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99; width: 15%;\">Proficiency Class\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC; width: 42.5%;\">Martial Weapon Proficiency\n</td>\n<th class=\"bg-color-2\" rowspan=\"19\" style=\"background:#EEFFCC;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Belashyrra%27s_Cleansed_Scepter_shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Belashyrra%27s_Cleansed_Scepter_shown.jpg/420px-Belashyrra%27s_Cleansed_Scepter_shown.jpg\" decoding=\"async\" width=\"420\" height=\"318\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/thumb/Belashyrra%27s_Cleansed_Scepter_shown.jpg/630px-Belashyrra%27s_Cleansed_Scepter_shown.jpg 1.5x, https://images.ddowiki.com/Belashyrra%27s_Cleansed_Scepter_shown.jpg 2x\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Accepts Sentience?\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">No\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Damage and Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">2.20[1d4] + 5 Bludgeon, Magic\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\"><a href=\"/page/Threat_range\" title=\"Threat range\">Critical threat range</a>\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">20 / x2\n</td></tr