  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><figure class=\"mw-halign-left\" typeof=\"mw:File/Frameless\"><a href=\"/page/Category:Feet_items\" title=\"Category:Feet items\"><img src=\"https://images.ddowiki.com/Icon_ItemSlot_Feet.png\" decoding=\"async\" width=\"32\" height=\"32\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure> \n<h2><span class=\"mw-headline\" id=\"Boots_of_Grounding\">Boots of Grounding</span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #DDAAFF solid; margin: 4px; width: 100%; --bg-color-1:#DDA0DD;--bg-color-1-dark:#773777;--bg-color-2:#EEDDFF;--bg-color-2-dark:#3A2F45;--header-color:#DDA0DD;--header-color-dark:#773777;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\" width=\"15%\">Minimum level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\" width=\"42.5%\">28\n</td>\n<th rowspan=\"11\" class=\"bg-color-2\" style=\"background-color: #EEDDFF;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Boots_Red.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/Boots_Red.png\" decoding=\"async\" width=\"420\" height=\"398\" class=\"mw-file-element\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Item Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">Clothing / Boots\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\"><a href=\"/page/Slot\" class=\"mw-redirect\" title=\"Slot\">Slot</a>\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">Feet\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\"><a href=\"/page/Bind\" title=\"Bind\">Unbound</a>, Drops on leaving adventure\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">290\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Material\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\"><style data-mw-deduplicate=\"TemplateStyles:r705484\">.mw-parser-output span.popup.has_tooltip{cursor:pointer;position:relative}.mw-parser-output span.popup.has_tooltip.no-icon{border-bottom:1px dashed #999999}.mw-parser-output span.popup.has_tooltip>span.popup.tooltip{background-color:#EEEEEE;background-color:var(--background-color-neutral,#EEEEEE);border:1px solid #333333;border-radius:3px;box-shadow:3px 5px 10px;color:#202122;color:var(--color-base,#202122);cursor:text;display:none;margin:0px;max-width:500px;padding:5px;width:250px;z-index:10000}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.narrow{width:100px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.fill{padding:5px 12px;width:max-content}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.wide{width:450px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.custom{max-width:80vw}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip{display:block;position:absolute}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.above{bottom:100%;top:auto;margin-bottom:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.middle{bottom:auto;top:50%;margin-top:-1em}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.below{bottom:auto;top:100%;margin-top:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.left{left:0px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center{left:50%;margin-left:-125px;