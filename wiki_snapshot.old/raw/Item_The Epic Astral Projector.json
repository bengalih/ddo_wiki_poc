  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><h2><span class=\"mw-headline\" id=\"The_Epic_Astral_Projector\">The Epic Astral Projector</span></h2>\n<table style=\"clear: right; border: 1px #B1D3A0 solid; margin: 4px; --bg-color-1:#CCFF99;--bg-color-1-dark:#3D5F1A;--bg-color-2:var(--background-color-disabled-subtle, #D3D3D3);\" width=\"100%\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background-color: #B1D3A0;\">Minimum Level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #D3D3D3;\">21\n</td>\n<th rowspan=\"13\" class=\"bg-color-2\" style=\"width: 425px; background-color: #D3D3D3;\" align=\"center\"><figure class=\"mw-halign-center\" typeof=\"mw:File/Frameless\"><a href=\"/page/File:Ghost_Shot_icon.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/Ghost_Shot_icon.png\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure><br /><a href=\"/page/Ghost_Shot\" title=\"Ghost Shot\">Ghost Shot</a>\n<table class=\"fakeClass\" style=\"width: 420px; font-weight: normal; text-align: left;\">\n<tbody><tr><th>Target:</th><td>Foe, Directional, Breakable</td></tr>\n<tr><th>School:</th><td>Evocation</td></tr><tr><th>Spell Resistance:</th><td>No</td></tr>\n<tr><th>Description:</th><td>Fires a Spectre that damage your enemies. At higher charge levels multiple ghosts are rapidly fired. Opponents struck by the ghosts receive a <a href=\"/page/Fortitude_save\" title=\"Fortitude save\">Fortitude save</a> for half damage.</td></tr>\n<tr><th colspan=\"2\">&#160;</th></tr>\n<tr><th style=\"width: 100px;\">Charge Tier I:</th><td>4 to 10 &#8203; + 1 to 2 per Artificer Level</td></tr><tr><th style=\"width: 100px;\">Charge Tier II:</th><td>5 to 15 &#8203; + 1 to 4 per Artificer Level</td></tr><tr><th style=\"width: 100px;\">Charge Tier III:</th><td>6 to 20 &#8203; + 1 to 6 per Artificer Level</td></tr><tr><th style=\"width: 100px;\">Charge Tier IV:</th><td>7 to 25 &#8203; + 1 to 8 per Artificer Level</td></tr><tr><th style=\"width: 100px;\">Charge Tier V:</th><td>8 to 30 &#8203; + 1 to 10 per Artificer Level</td></tr>\n</tbody></table>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #B1D3A0;\">Required Trait\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #D3D3D3;\"><a href=\"/page/Rune_Arm_Use\" title=\"Rune Arm Use\"> Artificer Rune Arm Use</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #B1D3A0;\"><a href=\"/page/Use_Magical_Device\" class=\"mw-redirect\" title=\"Use Magical Device\">Use Magical Device</a> <a href=\"/page/DC\" class=\"mw-redirect\" title=\"DC\">DC</a>\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #D3D3D3;\">\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #B1D3A0;\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #D3D3D3;\"><a href=\"/page/Bind\" title=\"Bind\">Bound to Account&#160;on Acquire</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #B1D3A0;\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #D3D3D3;\">355 / 355\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #B1D3A0;\">Made from\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #D3D3D3;\"><style data-mw-deduplicate=\"TemplateStyles:r705484\">.mw-parser-output span.popup.has_tooltip{cursor:pointer;position:relative}.mw-parser-output span.popup.has_tooltip.no-icon{border-bottom:1px dashed #999999}.mw-parser-output span.popup.has_tooltip>span.popup.tooltip{background-color:#EEEEEE;background-color:var(--background-color-neutral,#EEEEEE);border:1px solid #333333;border-radius:3px;box-shadow:3px 5px 10px;color:#202122;color:var(--color-base,#202122);cursor:text;display:none;margin:0px;max-width:500px;padding:5px;width:250px;z-index:10000}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.narrow{width:100px}.mw-parser-output span.popup.has_too