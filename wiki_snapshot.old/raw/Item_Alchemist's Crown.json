  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><figure class=\"mw-halign-left\" typeof=\"mw:File/Frameless\"><a href=\"/page/Category:Head_items\" title=\"Category:Head items\"><img src=\"https://images.ddowiki.com/Icon_ItemSlot_Head.png\" decoding=\"async\" width=\"32\" height=\"32\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure> \n<h2><span id=\"Alchemist.27s_Crown\"></span><span class=\"mw-headline\" id=\"Alchemist's_Crown\">Alchemist's Crown</span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #DDAAFF solid; margin: 4px; width: 100%; --bg-color-1:#DDA0DD;--bg-color-1-dark:#773777;--bg-color-2:#EEDDFF;--bg-color-2-dark:#3A2F45;--header-color:#DDA0DD;--header-color-dark:#773777;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\" width=\"15%\">Minimum level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\" width=\"42.5%\">18\n</td>\n<th rowspan=\"11\" class=\"bg-color-2\" style=\"background-color: #EEDDFF;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Circlet_of_Persuasion_shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Circlet_of_Persuasion_shown.jpg/420px-Circlet_of_Persuasion_shown.jpg\" decoding=\"async\" width=\"420\" height=\"133\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/thumb/Circlet_of_Persuasion_shown.jpg/630px-Circlet_of_Persuasion_shown.jpg 1.5x, https://images.ddowiki.com/thumb/Circlet_of_Persuasion_shown.jpg/840px-Circlet_of_Persuasion_shown.jpg 2x\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Item Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">Clothing / Helm\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\"><a href=\"/page/Slot\" class=\"mw-redirect\" title=\"Slot\">Slot</a>\n</th>\n<td class=\"bg-color-2\" style=\"background-c