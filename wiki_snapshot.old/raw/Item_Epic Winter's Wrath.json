  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><h2><span id=\"Epic_Winter.27s_Wrath\"></span><span class=\"mw-headline\" id=\"Epic_Winter's_Wrath\">Epic Winter's Wrath</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/edit/Template:Eternal_wand?section=T-1\" title=\"Edit section: Epic Winter&#39;s Wrath\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"border-color-1\" style=\"clear: right; border: 1px #DDF solid; margin: 4px; width: 95%; --bg-color-1:#DDDDFF;--bg-color-1-dark:#626474;--bg-color-2:#EEEEFF;--bg-color-2-dark:#515366;--border-color-1:#DDDDFF;--border-color-1-dark:#626474;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background: #DDF;\" width=\"20%\"><a href=\"/page/UMD\" class=\"mw-redirect\" title=\"UMD\">UMD</a> Difficulty\n</th>\n<td class=\"bg-color-2\" style=\"background: #EEF;\" width=\"50%\">45\n</td>\n<th class=\"bg-color-1\" style=\"background: #DDF;\" width=\"30%\" rowspan=\"10\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:OtilukesFreezingSphere.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/OtilukesFreezingSphere.png\" decoding=\"async\" width=\"60\" height=\"60\" class=\"mw-file-element\" /></a></span> <br /><a href=\"/page/Otiluke%27s_Freezing_Sphere\" title=\"Otiluke&#39;s Freezing Sphere\">Otiluke's Freezing Sphere</a><br />\n<p>Caster Level: 20<br />\n15/15 Charges<br />\nRecharged/Day: 15\n</p>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background: #DDF;\">No <a href=\"/page/UMD\" class=\"mw-redirect\" title=\"UMD\">UMD</a> check for:\n</th>\n<td class=\"bg-color-2\" style=\"background: #EEF;\"><a href=\"/page/Wizard\" title=\"Wizard\">Wiz</a>, <a href=\"/page/Sorcerer\" title=\"Sorcerer\">Sor</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background: #DDF;\">Minimum Level:\n</th>\n<td class=\"bg-color-2\" style=\"background: #EEF;\">20\n<