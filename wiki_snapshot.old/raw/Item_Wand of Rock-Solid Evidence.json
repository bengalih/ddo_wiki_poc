  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><h2><span class=\"mw-headline\" id=\"Wand_of_Rock-Solid_Evidence\">Wand of Rock-Solid Evidence</span><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/edit/Template:Eternal_wand?section=T-1\" title=\"Edit section: Wand of Rock-Solid Evidence\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></h2>\n<table class=\"border-color-1\" style=\"clear: right; border: 1px #DDF solid; margin: 4px; width: 95%; --bg-color-1:#DDDDFF;--bg-color-1-dark:#626474;--bg-color-2:#EEEEFF;--bg-color-2-dark:#515366;--border-color-1:#DDDDFF;--border-color-1-dark:#626474;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background: #DDF;\" width=\"20%\"><a href=\"/page/UMD\" class=\"mw-redirect\" title=\"UMD\">UMD</a> Difficulty\n</th>\n<td class=\"bg-color-2\" style=\"background: #EEF;\" width=\"50%\">\n</td>\n<th class=\"bg-color-1\" style=\"background: #DDF;\" width=\"30%\" rowspan=\"10\" align=\"center\">[[File:|60x60px]] <br /><a href=\"/page/Minotaur_Flesh_to_Stone\" title=\"Minotaur Flesh to Stone\">Minotaur Flesh to Stone</a><br />\n<p>Caster Level: 20<br />\n7/7 Charges<br />\n</p>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background: #DDF;\">No <a href=\"/page/UMD\" class=\"mw-redirect\" title=\"UMD\">UMD</a> check for:\n</th>\n<td class=\"bg-color-2\" style=\"background: #EEF;\">anyone\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background: #DDF;\">Minimum Level:\n</th>\n<td class=\"bg-color-2\" style=\"background: #EEF;\">1\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background: #DDF;\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background: #EEF;\"><a href=\"/page/Bind\" title=\"Bind\">Unbound</a>, Drops on death, Drops on leaving adventure\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background: #DDF;\">Durability:\n</th>\n<td class=\"bg-color-2\" style=\"background: #EEF;\">25\n</td></tr>\n<t