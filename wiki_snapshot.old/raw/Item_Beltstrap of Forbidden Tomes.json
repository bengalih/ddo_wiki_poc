ft:50%;margin-left:-125px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.narrow{margin-left:-50px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.fill{left:-262px;margin-left:auto;margin-right:auto;right:-262px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.wide{margin-left:-225px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.right{left:auto;right:0px}</style><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Steel\" title=\"Steel\">Steel</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Steel\" title=\"Steel\">Steel</a>:</b> <b>Steel</b> is the common metal used to make weapons and armor.</span></span> \n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Hardness\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">52\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF; width: 150px;\">Base Value\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF; width: 450px;\"><span style=\"display: none;\">0012801000</span>12,801<span class=\"popup has&#95;tooltip with-icon basic\">pp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Platinum Piece</a></span></span>&#160;\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">0.10 lbs\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\"><b><a href=\"/page/Unholy_Defiler_of_the_Hidden_Hand\" title=\"Unholy Defiler of the Hidden Hand\">Unholy Defiler of the Hidden Hand</a></b>, defiled version of <a href=\"/page/Item:Legendary_Book-Cover_Beltstrap\" title=\"Item:Legendary Book-Cover Beltstrap\">Legendary Book-Cover Beltstrap</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Dexterity\" title=\"Dexterity\">Quality Dexterity +3</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Dexterity\" title=\"Dexterity\">Quality Dexterity +3</a></b>: This item makes the wearer more nimble and dexterous, granting a +3 <a href=\"/page/Quality_bonus\" title=\"Quality bonus\">Quality bonus</a> to Dexterity.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Doubleshot\" title=\"Doubleshot\">Insightful Doubleshot 5%</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Doubleshot\" title=\"Doubleshot\">Insightful Doubleshot 5%</a>:</b> Passive: 5% <a href=\"/page/Insight_bonus\" title=\"Insight bonus\">Insight bonus</a> to Doubleshot. (Doubleshot is a chance to score an additional hit with a ranged attack.)</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Cannith_Combat_Infusion\" title=\"Cannith Combat Infusion\">Cannith Combat Infusion</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Cannith_Combat_Infusion\" title=\"Cannith Combat Infusion\">Cannith Combat Infusion</a>:</b> Your ranged and melee attacks have a chance to cause this item to inject a Cannith Combat Infusion into your bloodstream. For the next ten seconds, this will grant a +4 Alchemical bonus to Strength, Constitution and Dexterity, as well as a 5% Alchemical bonus to your chance to <a href=\"/page/Doublestrike\" title=\"Doublestrike\">doublestrike</a> and a +2 Alchemical bonus to <a href=\"/page/Armor_Class\" title=\"Armor Class\">Armor Class</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Utter_Disintegration_Guard\" class=\"mw-redirect\" title=\"Utter Disintegration Guard\">Utter Disintegration&#32;Guard</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Utter_Disintegration_Guard\" class=\"mw-redirect\" title=\"Utter Disintegration Guard\">Utter Disintegration&#32;Guard</a>:</b> This item has a dark, insidious power deep within. Occasionally, this power lashes out violently at enemies that strike you and attempts to disintegrate them. This disintegrate is incredibly powerful, and will utterly destroy weaker foes.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Taint_of_Evil\" title=\"Taint of Evil\">Taint of Evil</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Taint_of_Evil\" title=\"Taint of Evil\">Taint of Evil</a>:</b> Good aligned characters equipping this item suffer a temporary <a href=\"/page/Negative_level\" title=\"Negative level\">negative level</a> until the item is removed.</span></span></li>\n<li><style data-mw-deduplicate=\"TemplateStyles:r705465\">.mw-parser-output span.popup.augment.orange>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Orange\"]{background-color:#F4A460;border-color:#0B5B9F}.mw-parser-output span.popup.augment.purple>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Purple\"]{background-color:#DDA0DD;border-color:#225F22}.mw-parser-output span.popup.augment.green>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Green\"]{background-color:#90EE90;border-color:#6F116F}.mw-parser-output span.popup.augment.yellow>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Yellow\"]{background-color:#EEE8AA;border-color:#111755}.mw-parser-output span.popup.augment.blue>span.title,.mw-parser-output span.popup.augme