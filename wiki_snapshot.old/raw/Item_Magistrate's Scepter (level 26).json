  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><h2><span id=\"Magistrate.27s_Scepter\"></span><span class=\"mw-headline\" id=\"Magistrate's_Scepter\"><a href=\"/page/Item:Magistrate%27s_Scepter\" title=\"Item:Magistrate&#39;s Scepter\">Magistrate's Scepter</a></span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #CCFF99 solid; margin: 4px; width: 100%; --bg-color-1:#CCFF99;--bg-color-1-dark:#3D5F1A;--bg-color-2:#EEFFCC;--bg-color-2-dark:#272F17;--header-color:#CCFF99;--header-color-dark:#3D5F1A;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99; width: 15%;\">Proficiency Class\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC; width: 42.5%;\">Simple Weapon Proficiency\n</td>\n<th class=\"bg-color-2\" rowspan=\"19\" style=\"background:#EEFFCC;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Magistrate%27s_Scepter_shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/Magistrate%27s_Scepter_shown.jpg\" decoding=\"async\" width=\"420\" height=\"596\" class=\"mw-file-element\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Accepts Sentience?\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">No\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Damage and Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">1.50[1d8] + 6 Bludgeon, Lawful, Magic\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\"><a href=\"/page/Threat_range\" title=\"Threat range\">Critical threat range</a>\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">20 / x2\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Weapon Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\"><b><a href=\"/page/Heavy_Mace\" title=\"Heavy Mace\">Heavy Mace</a></b> / Bludgeoning weapons\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Minimum Level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">26\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Required Trait\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">None\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\"><a href=\"/page/Use_Magical_Device\" class=\"mw-redirect\" title=\"Use Magical Device\">Use Magical Device</a> <a href=\"/page/DC\" class=\"mw-redirect\" title=\"DC\">DC</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">No UMD needed\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Handedness\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Attack Mod\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">STR\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Damage Mod\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">STR\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><a href=\"/page/Bind\" title=\"Bind\">Bound to Character&#160;on Equip</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">320\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Made from\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><style data-mw-deduplicate=\"TemplateStyles:r705484\">.mw-parser-output span.popup.has_tooltip{cursor:pointer;position:relative}.mw-parser-output span.popup.has_tooltip.no-icon{border-bottom:1px dashed #999999}.mw-parser-output span.popup.has_tooltip>span.popup.tooltip{background-color:#EEEEEE;background-color:var(--background-color-neutral,#EEEEEE);border:1px solid #333333;border-radius:3px;box-shadow:3px 5px 10px;color:#202122;color:var(--color-base,#202122);cursor:text;display:none;margin:0px;max-width:500px;padding:5px;width:250px;z-index:10000}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.narrow{width:100px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.fill{padding:5px 12px;width:max-content}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.wide{width:450px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.custom{max-width:80vw}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip{display:block;position:absolute}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.above{bottom:100%;top:auto;margin-bottom:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.middle{bottom:auto;top:50%;margin-top:-1em}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.below{bottom:auto;top:100%;margin-top:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.left{left:0px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center{left:50%;margin-left:-125px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.narrow{margin-left:-50px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.fill{left:-262px;margin-left:auto;margin-right:auto;right:-262px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.wide{margin-left:-225px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.right{left:auto;right:0px}</style><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Steel\" title=\"Steel\">Steel</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Steel\" title=\"Steel\">Steel</a>:</b> <b>Steel</b> is the common metal used to make weapons and armor.</span></span> \n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Hardness\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">36\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Base Value\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><span style=\"display: none;\">0010401200</span>10,401<span class=\"popup has&#95;tooltip with-icon basic\">pp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Platinum Piece</a></span></span>&#160;2<span class=\"popup has&#95;tooltip with-icon basic\">gp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Gold Piece</a></span></span>&#160;\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">8 lbs\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><b><a href=\"/page/The_Tracker%27s_Trap\" title=\"The Tracker&#39;s Trap\">The Tracker's Trap</a></b>, End chest (Epic Normal)<br /><a href=\"/page/The_Secret_of_the_Storm_Horns\" title=\"The Secret of the Storm Horns\">The Secret of the Storm Horns</a>, Quest chain end reward (Epic)\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+6 Enhancement Bonus</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+6 Enhancement Bonus</a>:</b> +6 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">enhancement bonus</a> to <a href=\"/page/Attack_roll\" title=\"Attack roll\">attack</a> and <a href=\"/page/Damage_roll\" title=\"Damage roll\">damage rolls</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Alignment_damage_(weapon)\" title=\"Alignment damage (weapon)\">Axiomatic IV</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Alignment_damage_(weapon)\" title=\"Alignment damage (weapon)\">Axiomatic IV</a>:</b> On Hit: 4 to 16 Law damage. Law-aligned creatures are immune to this effect.<br />Penalty: If equipped by a Chaotic user, they receive 1 Negative Level for as long as this item is equipped.</span></span></li>\n<li>One of the following:\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Dazing\" title=\"Dazing\"> Dazing VIII</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Dazing\" title=\"Dazing\"> Dazing VIII</a>:</b> On Hit: Your target suffers a -1 Penalty to <a href=\"/page/Will\" class=\"mw-redirect\" title=\"Will\">Will</a> Saving Throws for 6 seconds. This effect stacks up to 5 times. This effect may only occur on-hit once every three seconds.<br />Passive: The DC of the saving throw to resist your <a href=\"/page/Stunning_Blow\" title=\"Stunning Blow\">Stunning Blow</a> and <a href=\"/page/Stunning_Fist\" title=\"Stunning Fist\">Stunning Fist</a> combat feats is increased by 13.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Deception\" title=\"Deception\">Deception VIII</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Deception\" title=\"Deception\">Deception VIII</a>:</b> 5% Chance on Hit: Your target becomes Bluffed for four seconds. (Bluffed enemies can be affected by Sneak Attacks even while targeting you.) On sneak attack: +8 to Attack Rolls, +16 to Damage.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Doublestrike\" title=\"Doublestrike\"> Doublestrike 8%</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Doublestrike\" title=\"Doublestrike\"> Doublestrike 8%</a>:</b> Passive: 8% <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Doublestrike. (Doublestrike is a chance to score an additional hit with a melee attack.)</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Draining\" title=\"Draining\">Draining&#32;VIII</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Draining\" title=\"Draining\">Draining&#32;VIII</a>:</b> On <a href=\"/page/Vorpal_Strike\" title=\"Vorpal Strike\"> Vorpal Hit</a>: Your target incurs one <a href=\"/page/Negative_Level\" class=\"mw-redirect\" title=\"Negative Level\">Negative Level</a>, and you gain +16 Temporary Spell Points. (These Temporary Spell Points last for one minute, or until used to reduce the cost of your next spell.)</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Feeding\" title=\"Feeding\">Feeding&#32;VIII</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Feeding\" title=\"Feeding\">Feeding&#32;VIII</a>:</b> On <a href=\"/page/Vorpal_Strike\" title=\"Vorpal Strike\">Vorpal Hit</a>: Your target incurs one <a href=\"/page/Negative_Level\" class=\"mw-redirect\" title=\"Negative Level\">Negative Level</a>, and you gain +40 <a href=\"/page/Temporary_hit_point\" title=\"Temporary hit point\">temporary hit points</a>. (These Temporary Hit Points last for one minute, or until used to negate incoming damage.)</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Ghostbane\" title=\"Ghostbane\">Ghostbane VIII</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Ghostbane\" title=\"Ghostbane\">Ghostbane VIII</a>:</b> On Hit: 8 to 32 Bane Damage vs <a href=\"/page/Undead\" class=\"mw-redirect\" title=\"Undead\">Undead</a>. (Bane damage cannot be resisted.)<br />Passive: Attacks from this weapon bypass the miss chance of <a href=\"/page/Incorporeal\" title=\"Incorporeal\">incorporeal</a> creatures, such as ghosts, shadows, and wraiths.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Disruption#Greater_Disruption\" title=\"Disruption\"> Greater Disruption</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Disruption#Greater_Disruption\" title=\"Disruption\"> Greater Disruption</a>:</b> On Hit: 4 to 24 <a href=\"/page/Bane\" title=\"Bane\">Bane</a> damage to <a href=\"/page/Undead\" class=\"mw-redirect\" title=\"Undead\">Undead</a>.<br />On <a href=\"/page/Vorpal_Strike\" title=\"Vorpal Strike\">Vorpal Hit</a>: If an undead struck by this weapon has fewer than 2000 Hit Points, it is instantly slain. If the undead has above 2000 Hit Points, it takes 200 damage.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Smiting#Greater_Smiting\" title=\"Smiting\"> Greater Smiting</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Smiting#Greater_Smiting\" title=\"Smiting\"> Greater Smiting</a>:</b> On Hit: 4 to 24 <a href=\"/page/Bane\" title=\"Bane\">Bane</a> damage to <a href=\"/page/Construct\" class=\"mw-redirect\" title=\"Construct\">Constructs</a>.<br />On <a href=\"/page/Vorpal_Strike\" title=\"Vorpal Strike\">Vorpal Hit</a>: If a construct struck by this weapon has fewer than 2000 Hit Points, it is instantly slain. If the construct has above 2000 Hit Points, it takes 200 damage.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Bane_(enchantment)\" title=\"Bane (enchantment)\">Humanoid Bane VIII</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Bane_(enchantment)\" title=\"Bane (enchantment)\">Humanoid Bane VIII</a>:</b> On Hit: 8 to 32 Bane Damage vs <a href=\"/page/Humanoid\" class=\"mw-redirect\" title=\"Humanoid\">Humanoids</a> and <a href=\"/page/Giant\" title=\"Giant\">Giants</a>. (Bane damage cannot be resisted.)</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Bane_(enchantment)\" title=\"Bane (enchantment)\">Natural Bane VIII</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Bane_(enchantment)\" title=\"Bane (enchantment)\">Natural Bane VIII</a>:</b> On Hit: 8 to 32 Bane Damage vs <a href=\"/page/Animal\" class=\"mw-redirect\" title=\"Animal\">Animals</a>, <a href=\"/page/Vermin\" class=\"mw-redirect\" title=\"Vermin\">Vermin</a>, <a href=\"/page/Magical_Beast\" class=\"mw-redirect\" title=\"Magical Beast\">Magical Beasts</a>, <a href=\"/page/Plant\" class=\"mw-redirect\" title=\"Plant\">Plants</a> and <a href=\"/page/Fey\" class=\"mw-redirect\" title=\"Fey\">Fey</a>. (Bane damage cannot be resisted.)</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Ribcracker\" title=\"Ribcracker\">Ribcracker VIII</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Ribcracker\" title=\"Ribcracker\">Ribcracker VIII</a>:</b> On Critical Hit: 17 to 102 Bludgeoning damage from weapons with a x2 Critical Multiplier, 17 to 136 Bludgeoning damage from weapons with a x3 Critical Multiplier, and 17 to 170 Bludgeoning damage from weapons with a x4 or greater Critical Multiplier.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Riposte\" title=\"Riposte\">Riposte VIII</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Riposte\" title=\"Riposte\">Riposte VIII</a>:</b> When Missed by an attack: Deals 8 to 32 damage to your attacker. Passive: +4 <a href=\"/page/Insight_bonus\" title=\"Insight bonus\">Insight bonus</a> to <a href=\"/page/Armor_Class\" title=\"Armor Class\">Armor Class</a>, +4 <a href=\"/page/Insight_bonus\" title=\"Insight bonus\">Insight bonus</a> to <a href=\"/page/Fortitude\" class=\"mw-redirect\" title=\"Fortitude\">Fortitude</a>, <a href=\"/page/Reflex\" class=\"mw-redirect\" title=\"Reflex\">Reflex</a>, and <a href=\"/page/Will\" class=\"mw-redirect\" title=\"Will\">Will</a> <a href=\"/page/Saving_Throw\" class=\"mw-redirect\" title=\"Saving Throw\">Saving Throws</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Stumbling\" class=\"mw-redirect\" title=\"Stumbling\"> Stumbling VIII</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><s