ip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Blueshine\" title=\"Blueshine\">Blueshine</a>:</b> This item glistens with a blue-black sheen, as if it were covered in oily liquid sapphire. A suit of armor imbued with this property never tarnishes and is immune to acid damage and rusting effects, like-wise weapons made with this will not be easily damaged by Rust Monsters either.  While wearing <a href=\"/page/Blueshine\" title=\"Blueshine\">blueshine</a> armor, you gain a +3 <a href=\"/page/Competence_bonus\" title=\"Competence bonus\">competence bonus</a> on <a href=\"/page/Hide\" title=\"Hide\">Hide</a> checks.</span></span> \n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Hardness\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">28\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Base Value\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><span style=\"display: none;\">0000000001</span>1<span class=\"popup has&#95;tooltip with-icon basic\">cp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Copper Piece</a></span></span>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">3 lbs\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><b><a href=\"/page/Rainbow_in_the_Dark\" title=\"Rainbow in the Dark\">Rainbow in the Dark</a></b>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Spellcasting_Implement\" title=\"Spellcasting Implement\">Spellcasting Implement +15</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Spellcasting_Implement\" title=\"Spellcasting Implement\">Spellcasting Implement +15</a>:</b> Passive: +15 <a href=\"/page/Implement_bonus\" class=\"mw-redirect\" title=\"Implement bonus\">Implement bonus</a> to Universal <a href=\"/page/Spell_Power\" title=\"Spell Power\">Spell Power</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+5 Enhancement Bonus</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+5 Enhancement Bonus</a>:</b> +5 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">enhancement bonus</a> to <a href=\"/page/Attack_roll\" title=\"Attack roll\">attack</a> and <a href=\"/page/Damage_roll\" title=\"Damage roll\">damage rolls</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Everbright\" title=\"Everbright\">Everbright</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Everbright\" title=\"Everbright\">Everbright</a>:</b> Flecks of marble and pearl shimmer across this shield, set within images of bursting stars and beaming suns. An everbright shield will never take damage from rust or acid and can emit a Blinding Flash 3/rest.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Wizardry\" title=\"Wizardry\">Archmagi</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Wizardry\" title=\"Wizardry\">Archmagi</a>: </b>This item grants the wearer +200 maximum <a href=\"/page/Spell_point\" title=\"Spell point\">spell points</a>. <a href=\"/page/Sorcerer\" title=\"Sorcerer\">Sorcerers</a> and <a href=\"/page/Favored_Soul\" title=\"Favored Soul\">Favored Souls</a> gain up to double spell points from items.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Potency\" title=\"Potency\">Potency +56</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Potency\" title=\"Potency\">Potency +56</a>:</b> Passive: +56 <a href=\"/page/Equipment_bonus\" title=\"Equipment bonus\">Equipment bonus</a> to each <a href=\"/page/Spell_Power\" title=\"Spell Power\">Spell Power</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Metalline\" title=\"Metalline\">Metalline</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Metalline\" title=\"Metalline\">Metalline</a>:</b> <b>Metalline</b> bypasses any metal based damage reduction. (<a href=\"/page/Adamantine\" title=\"Adamantine\">Adamantine</a>, <a href=\"/page/Silver\" title=\"Silver\">\"Alchemical, Silver\"</a>, <a href=\"/page/Byeshk\" title=\"Byeshk\">Byeshk</a>, <a href=\"/page/Cold_Iron\" title=\"Cold Iron\">Cold Iron</a>, <a href=\"/page/Mithral\" title=\"Mithral\">Mithral</a>)</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Blinding_Flash\" title=\"Blinding Flash\">Blinding Flash </a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><b><a href=\"/page/Blinding_Flash\" title=\"Blinding Flash\">Blinding Flash </a></b><br /><b>Caster level:</b> 5<br /><b>Charges: </b>3 (3/day)</span></span> <b>—</b> 3 Charges&#32;(Recharged/Day:3)</li></ul>\n</td>\n<td class=\"bg-color-2\" style=\"background:#EFC; vertical-align: middle;\" rowspan=\"4\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Radiant_Arc.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Radiant_Arc.png/420px-Radiant_Arc.png\" decoding=\"async\" width=\"420\" height=\"700\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Radiant_Arc.png 1.5x\" /></a></span>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Upgradeable?\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Description\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><i>Light emits from a crystal situated at the head of this scepter. It ceases to function when beyond the influence of a magically bound receptor pedestal.</i>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Tips\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n<p class=\"mw-empty-elt\">\n</p>\n<ul><li><span style=\"background-color: initial; color: #FF0000;\"><span style=\"font-size: larger; font-weight: inherit;\"><i>This item cannot be fed to <a href=\"/page/Sentient_Weapon\" title=\"Sentient Weapon\">sentient jewels</a>.</i></span></span></li>\n<li>The light of the scepter will not shine if a cosmetic is in the same hand.</li>\n<li><b>Bug: </b> You may have to equip this on your offhand to get the light from it.</li></ul>\n</td></tr></tbody></table>\n<!-- \nNewPP limit report\nCached time: 20260816182025\nCache expiry: 86400\nReduced expiry: false\nComplications: []\nCPU time usage: 0.090 seconds\nReal time usage: 0.150 seconds\nPreprocessor visited node count: 5141/1000000\nPost‐expand include size: 36822/2097152 bytes\nTemplate argument size: 11742/2097152 bytes\nHighest expansion depth: 32/100\nExpensive parser function count: 0/200\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 2019/5000000 bytes\nExtLoops count: 13/150\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n104.81%  137.026     63 Template:IO\n100.00%  130.744      1 Template:Named_item\n100.00%  130.744 