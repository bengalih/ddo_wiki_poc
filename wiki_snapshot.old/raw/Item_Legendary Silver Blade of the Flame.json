:#CF9\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Minimum Level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">29\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Required Trait\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">None\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\"><a href=\"/page/Use_Magical_Device\" class=\"mw-redirect\" title=\"Use Magical Device\">Use Magical Device</a> <a href=\"/page/DC\" class=\"mw-redirect\" title=\"DC\">DC</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">No UMD needed\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Handedness\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Attack Mod\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">STR\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Damage Mod\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">STR\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><a href=\"/page/Bind\" title=\"Bind\">Bound to Account</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">360\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Made from\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><style data-mw-deduplicate=\"TemplateStyles:r705484\">.mw-parser-output span.popup.has_tooltip{cursor:pointer;position:relative}.mw-parser-output span.popup.has_tooltip.no-icon{border-bottom:1px dashed #999999}.mw-parser-output span.popup.has_tooltip>span.popup.tooltip{background-color:#EEEEEE;background-color:var(--b