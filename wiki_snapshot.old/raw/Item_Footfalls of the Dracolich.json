  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><figure class=\"mw-halign-left\" typeof=\"mw:File/Frameless\"><a href=\"/page/Category:Feet_items\" title=\"Category:Feet items\"><img src=\"https://images.ddowiki.com/Icon_ItemSlot_Feet.png\" decoding=\"async\" width=\"32\" height=\"32\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure> \n<h2><span class=\"mw-headline\" id=\"Footfalls_of_the_Dracolich\">Footfalls of the Dracolich</span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #DDAAFF solid; margin: 4px; width: 100%; --bg-color-1:#DDA0DD;--bg-color-1-dark:#773777;--bg-color-2:#EEDDFF;--bg-color-2-dark:#3A2F45;--header-color:#DDA0DD;--header-color-dark:#773777;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\" width=\"15%\">Minimum level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\" width=\"42.5%\">33\n</td>\n<th rowspan=\"11\" class=\"bg-color-2\" style=\"background-color: #EEDDFF;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:QuestionOrb.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/QuestionOrb.png\" decoding=\"async\" width=\"420\" height=\"398\" class=\"mw-file-element\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Item Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">Clothing / Boots\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\"><a href=\"/page/Slot\" class=\"mw-redirect\" title=\"Slot\">Slot</a>\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">Feet\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\"><a href=\"/page/Bind\" title=\"Bind\">Bound to Character&#160;on Acquire</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">430\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Material\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\"><style data-mw-deduplicate=\"TemplateStyles:r705484\">.mw-parser-output span.popup.has_tooltip{cursor:pointer;position:relative}.mw-parser-output span.popup.has_tooltip.no-icon{border-bottom:1px dashed #999999}.mw-parser-output span.popup.has_tooltip>span.popup.tooltip{background-color:#EEEEEE;background-color:var(--background-color-neutral,#EEEEEE);border:1px solid #333333;border-radius:3px;box-shadow:3px 5px 10px;color:#202122;color:var(--color-base,#202122);cursor:text;display:none;margin:0px;max-width:500px;padding:5px;width:250px;z-index:10000}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.narrow{width:100px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.fill{padding:5px 12px;width:max-content}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.wide{width:450px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.custom{max-width:80vw}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip{display:block;position:absolute}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.above{bottom:100%;top:auto;margin-bottom:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.middle{bottom:auto;top:50%;margin-top:-1em}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.below{bottom:auto;top:100%;margin-top:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.left{left:0px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center{left:50%;margin-left:-125px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.narrow{margin-left:-50px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.fill{left:-262px;margin-left:auto;margin-right:auto;right:-262px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.wide{margin-left:-225px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.right{left:auto;right:0px}</style><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Leather\" title=\"Leather\">Leather</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Leather\" title=\"Leather\">Leather</a>:</b> <b>Leather</b> armor is made of the hide of animals. It provides decent protection without excessively restricting the user's movements.</span></span> \n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Hardness\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">53\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF; width: 150px;\">Base Value\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF; width: 450px;\"><span style=\"display: none;\">0013201000</span>13,201<span class=\"popup has&#95;tooltip with-icon basic\">pp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Platinum Piece</a></span></span>&#160;\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">0.10 lbs\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\"><b><a href=\"/page/Threats_Old_and_New\" title=\"Threats Old and New\">Threats Old and New</a></b>, Raid Warded chest\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Sheltering\" title=\"Sheltering\"> Sheltering +39</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Sheltering\" title=\"Sheltering\"> Sheltering +39</a>:</b> +39 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to <a href=\"/page/Physical_Resistance_Rating\" title=\"Physical Resistance Rating\">Physical</a> and <a href=\"/page/Magical_Resistance_Rating\" title=\"Magical Resistance Rating\">Magical</a> Resistance Ratings</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Freedom_of_Movement_(item_enchantment)\" class=\"mw-redirect\" title=\"Freedom of Movement (item enchantment)\">Freedom of Movement</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Freedom_of_Movement_(item_enchantment)\" class=\"mw-redirect\" title=\"Freedom of Movement (item enchantment)\">Freedom of Movement</a>:</b> This item grants its wearer the ability to move and attack normally while under the influence of magic that impedes movement, such as paralysis, solid fog, slow and web.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Feat\" title=\"Feat\">Feat</a>: <a href=\"/page/Elusive_Target\" title=\"Elusive Target\">Elusive Target</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Feat\" title=\"Feat\">Feat</a>: <a href=\"/page/Elusive_Target\" title=\"Elusive Target\">Elusive Target</a></b>: Each time you would be physically damaged, you have a +5% chance to completely ignore the damage. (This applies to physical attacks and spells that deal physical damage.)</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Sealed_in_Undeath\" title=\"Sealed in Undeath\">Sealed in Undeath</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Sealed_in_Undeath\" title=\"Sealed in Undeath\">Sealed in Undeath</a>:</b> This item seethes with a sealed power. It can have its power unsealed at the <a href=\"/page/Ritual_Table#Sealed_in_Undeath_clothing_/_jewelry_upgrades\" title=\"Ritual Table\">Ritual Table</a>, adding one effect. Attempting to add another will remove the original.<br /><br />Effect options: <span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Strength\" title=\"Strength\"> Strength +15</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Strength\" title=\"Strength\"> Strength +15</a></b>: This item gives the wearer the power of Ogre Strength, granting a +15 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Strength.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Constitution\" title=\"Constitution\"> Constitution +15</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Constitution\" title=\"Constitution\"> Constitution +15</a></b>: This item gives the wearer improved health, granting a +15 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Constitution.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Dexterity\" title=\"Dexterity\"> Dexterity +15</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Dexterity\" title=\"Dexterity\"> Dexterity +15</a></b>: This item makes the wearer more nimble and dexterous, granting a +15 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Dexterity.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Intelligence\" title=\"Intelligence\"> Intelligence +15</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Intelligence\" title=\"Intelligence\"> Intelligence +15</a></b>: This item focuses the power of the wearer's mind, granting a +15 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Intelligence.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Wisdom\" title=\"Wisdom\"> Wisdom +15</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Wisdom\" title=\"Wisdom\"> Wisdom +15</a></b>: This item makes the wearer more in tune with her surroundings, granting a +15 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Wisdom.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Charisma\" title=\"Charisma\"> Charisma +15</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Charisma\" title=\"Charisma\"> Charisma +15</a></b>: This item makes the wearer have more flair, granting a +15 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to Charisma.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Strength\" title=\"Strength\">Insightful Strength +7</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Strength\" title=\"Strength\">Insightful Strength +7</a></b>: This item gives the wearer the power of Ogre Strength, granting a +7 <a href=\"/page/Insight_bonus\" title=\"Insight bonus\">Insight bonus</a> to Strength.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Constitution\" title=\"Constitution\">Insightful Constitution +7</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Constitution\" title=\"Constitution\">Insightful Constitution +7</a></b>: This item gives the wearer improved health, granting a +7 <a href=\"/page/Insight_bonus\" title=\"Insight bonus\">Insight bonus</a> to Constitution.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Dexterity\" title=\"Dexterity\">Insightful Dexterity +7</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Dexterity\" title=\"Dexterity\">Insightful Dexterity +7</a></b>: This item makes the wearer more nimble and dexterous, granting a +7 <a href=\"/page/Insight_bonus\" title=\"Insight bonus\">Insight bonus</a> to Dexterity.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Intelligence\" title=\"Intelligence\">Insightful Intelligence +7</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Intelligence\" title=\"Intelligence\">Insightful Intelligence +7</a></b>: This item focuses the power of the wearer's mind, granting a +7 <a href=\"/page/Insight_bonus\" title=\"Insight bonus\">Insight bonus</a> to Intelligence.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Wisdom\" title=\"Wisdom\">Insightful Wisdom +7</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Wisdom\" title=\"Wisdom\">Insightful Wisdom +7</a></b>: This item makes the wearer more in tune with her surroundings, granting a +7 <a href=\"/page/Insight_bonus\" title=\"Insight bonus\">Insight bonus</a> to Wisdom.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Charisma\" title=\"Charisma\">Insightful Charisma +7</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Charisma\" title=\"Charisma\">Insightful Charisma +7</a></b>: This item makes the wearer have more flair, granting a +7 <a href=\"/page/Insight_bonus\" title=\"Insight bonus\">Insight bonus</a> to Charisma.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Strength\" title=\"Strength\">Quality Strength +3</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Strength\" title=\"Strength\">Quality Strength +3</a></b>: This item gives the wearer the power of Ogre Strength, granting a +3 <a href=\"/page/Quality_bonus\" title=\"Quality bonus\">Quality bonus</a> to Strength.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Constitution\" title=\"Constitution\">Quality Constitution +3</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Constitution\" title=\"Constitution\">Quality Constitution +3</a></b>: This item gives the wearer improved health, granting a +3 <a href=\"/page/Quality_bonus\" title=\"Quality bonus\">Quality bonus</a> to Constitution.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Dexterity\" title=\"Dexterity\">Quality Dexterity +3</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Dexterity\" title=\"Dexterity\">Quality Dexterity +3</a></b>: This item makes the wearer more nimble and dexterous, granting a +3 <a href=\"/page/Quality_bonus\" title=\"Quality bonus\">Quality bonus</a> to Dexterity.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Intelligence\" title=\"Intelligence\">Quality Intelligence +3</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Intelligence\" title=\"Intelligence\">Quality Intelligence +3</a></b>: This item focuses the power of the wearer's mind, granting a +3 <a href=\"/page/Quality_bonus\" title=\"Quality bonus\">Quality bonus</a> to Intelligence.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Wisdom\" title=\"Wisdom\">Quality Wisdom +3</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Wisdom\" title=\"Wisdom\">Quality Wisdom +3</a></b>: This item makes the wearer more in tune with her surroundings, granting a +3 <a href=\"/page/Quality_bonus\" title=\"Quality bonus\">Quality bonus</a> to Wisdom.</span></span><wbr />&#32;•&#160;<span class=\"popup has&#95;tooltip no-icon basic\"><a href=\"/page/Charisma\" title=\"Charisma\">Quality Charisma +3</a><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Charisma\" title=\"Charisma\">Quality Charisma +3</a></b>: This item makes the wearer have more flair, granting a +3 <a href=\"/page/Quality_bonus\" title=\"Quality bonus\">Quality bonus</a> to Charisma.</span></span></span></span></li>\n<li><style data-mw-deduplicate=\"TemplateStyles:r705465\">.mw-parser-output span.popup.augment.orange>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Orange\"]{background-color:#F4A460;border-color:#0B5B9F}.mw-parser-output span.popup.augment.purple>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Purple\"]{background-color:#DDA0DD;border-color:#225F22}.mw-parser-output span.popup.augment.green>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Green\"]{background-color:#90EE90;border-color:#6F116F}.mw-parser-output span.popup.augment.yellow>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Yellow\"]{background-color:#EEE8AA;border-color:#111755}.mw-parser-output span.popup.augment.blue>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Blue\"]{background-color:#87CEFA;border-color:#783105}.mw-parser-output span.popup.augment.red>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Red\"]{background-color:#FA8072;border-color:#057F8D}.mw-parser-output span.popup.augment.colorless>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Colorless\"]{background-color:#F8F8FF;border