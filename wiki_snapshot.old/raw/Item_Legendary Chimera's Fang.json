  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><h2><span id=\"Legendary_Chimera.27s_Fang\"></span><span class=\"mw-headline\" id=\"Legendary_Chimera's_Fang\">Legendary Chimera's Fang</span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #CCFF99 solid; margin: 4px; width: 100%; --bg-color-1:#CCFF99;--bg-color-1-dark:#3D5F1A;--bg-color-2:#EEFFCC;--bg-color-2-dark:#272F17;--header-color:#CCFF99;--header-color-dark:#3D5F1A;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99; width: 15%;\">Proficiency Class\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC; width: 42.5%;\">Exotic Weapon Proficiency\n</td>\n<th class=\"bg-color-2\" rowspan=\"19\" style=\"background:#EEFFCC;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Chimera%27s_Fang_shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/Chimera%27s_Fang_shown.jpg\" decoding=\"async\" width=\"420\" height=\"784\" class=\"mw-file-element\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Accepts Sentience?\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">Yes\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Damage and Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">5[1d10+2] + 15 Slash, Silver, Magic\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\"><a href=\"/page/Threat_range\" title=\"Threat range\">Critical threat range</a>\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">17-20 / x2\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Weapon Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\"><b><a href=\"/page/Bastard_Sword\" title=\"Bastard Sword\">Bastard Sword</a></b> / Slashing weapons\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Minimum Level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">30\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Required Trait\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">None\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\"><a href=\"/page/Use_Magical_Device\" class=\"mw-redirect\" title=\"Use Magical Device\">Use Magical Device</a> <a href=\"/page/DC\" class=\"mw-redirect\" title=\"DC\">DC</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">No UMD needed\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Handedness\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Attack Mod\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">STR\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Damage Mod\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">STR\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><a href=\"/page/Bind\" title=\"Bind\">Bound to Account&#160;on Acquire</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">400\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Made from\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><style data-mw-deduplicate=\"TemplateStyles:r705484\">.mw-parser-output span.popup.has_tooltip{cursor:pointer;position:relative}.mw-parser-output span.popup.has_tooltip.no-icon{border-bottom:1px dashed #999999}.mw-parser-output span.popup.has_tooltip>span.popup.tooltip{background-color:#EEEEEE;background-color:var(--background-color-neutral,#EEEEEE);border:1px solid #333333;border-radius:3px;box-shadow:3px 5px 10px;color:#202122;color:var(--color-base,#202122);cursor:text;display:none;margin:0px;max-width:500px;padding:5px;width:250px;z-index:10000}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.narrow{width:100px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.fill{padding:5px 12px;width:max-content}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.wide{width:450px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.custom{max-width:80vw}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip{display:block;position:absolute}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.above{bottom:100%;top:auto;margin-bottom:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.middle{bottom:auto;top:50%;margin-top:-1em}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.below{bottom:auto;top:100%;margin-top:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.left{left:0px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center{left:50%;margin-left:-125px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.narrow{margin-left:-50px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.fill{left:-262px;margin-left:auto;margin-right:auto;right:-262px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center.wide{margin-left:-225px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.right{left:auto;right:0px}</style><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Silver\" title=\"Silver\">Silver</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Silver\" title=\"Silver\">Silver</a>:</b> A complex process involving metallurgy and alchemy can bond <b>silver</b> to a <u>weapon made of steel</u> so that it bypasses the damage reduction of creatures such as devils and vampires. <br /> Silver weapons have 2 points lower hardness then equivalent steel weapons, and as such aren't quite as durable.</span></span> \n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Hardness\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">38\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Base Value\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><span style=\"display: none;\">0012023000</span>12,023<span class=\"popup has&#95;tooltip with-icon basic\">pp<span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip left below\" style=\"text-align: center;\"><a href=\"/page/Currency\" title=\"Currency\">Platinum Piece</a></span></span>&#160;\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Weight\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">8 lbs\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Location\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><a href=\"/page/Legendary_Crafting\" title=\"Legendary Crafting\">Legendary version</a> of <a href=\"/page/Item:Epic_Chimera%27s_Fang\" title=\"Item:Epic Chimera&#39;s Fang\">Epic Chimera's Fang</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Enchantments\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n<ul><li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+15 Enhancement Bonus</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">+15 Enhancement Bonus</a>:</b> +15 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">enhancement bonus</a> to <a href=\"/page/Attack_roll\" title=\"Attack roll\">attack</a> and <a href=\"/page/Damage_roll\" title=\"Damage roll\">damage rolls</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Keen\" title=\"Keen\">Keen</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Keen\" title=\"Keen\">Keen</a>:</b> Passive: The base critical <a href=\"/page/Threat_range\" title=\"Threat range\">threat range</a> of this weapon is doubled. This does not stack with <a href=\"/page/Improved_Critical\" title=\"Improved Critical\">Improved Critical</a> feat. <a href=\"/page/Vorpal_Strike\" title=\"Vorpal Strike\">Vorpal Strikes</a> by this weapon also bypass all <a href=\"/page/Fortification\" title=\"Fortification\">Fortification</a>.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Improved_Destruction\" class=\"mw-redirect\" title=\"Improved Destruction\">Improved Destruction</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Improved_Destruction\" class=\"mw-redirect\" title=\"Improved Destruction\">Improved Destruction</a>:</b> On Hit: Your target gains a stack of Armor Destruction. (-1 penalty to <a href=\"/page/Armor_Class\" title=\"Armor Class\">Armor Class</a>, -1% of its <a href=\"/page/Fortification\" title=\"Fortification\">Fortification</a>. 20 Second Duration. Stacks up to 15 times.) This effect may trigger once every second.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Blast_(enchantment)\" title=\"Blast (enchantment)\">Shocking Blast 6</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Blast_(enchantment)\" title=\"Blast (enchantment)\">Shocking Blast 6</a>:</b> This weapon arcs with deadly electricity, dealing 6d6 Electric damage on a successful hit, and an additional 6d6 Electric damage on a critical hit.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Shatter\" title=\"Shatter\">Shatter +15</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Shatter\" title=\"Shatter\">Shatter +15</a></b>: This effect gives a +15 <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to the DC to resist the character's <a href=\"/page/Sunder\" title=\"Sunder\">Sunder</a> and <a href=\"/page/Improved_Sunder\" title=\"Improved Sunder\">Improved Sunder</a> attempts.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Utter_Disintegration\" title=\"Utter Disintegration\">Utter Disintegration</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Utter_Disintegration\" title=\"Utter Disintegration\">Utter Disintegration</a>:</b> This weapon has a dark, insidious power deep within. Occasionally, this power lashes out violently at enemies and attempts to disintegrate them. This disintegrate is incredibly powerful, and will utterly destroy weaker foes.</span></span></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Chimera%27s_Ferocity\" title=\"Chimera&#39;s Ferocity\">Legendary Chimera's Ferocity</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b> <a href=\"/page/Chimera%27s_Ferocity\" title=\"Chimera&#39;s Ferocity\">Legendary Chimera's Ferocity</a></b>: This item grants extra bonuses if the wearer has been bestowed with <a href=\"/page/Dragonmark\" title=\"Dragonmark\">Dragonmarks</a>. Any dragonmark grants <a href=\"/page/Proficiency:_Bastard_Sword\" title=\"Proficiency: Bastard Sword\">Proficiency: Bastard Sword</a>; further bonuses are detailed below. </span></span>\n<ul><li>If you have a <a href=\"/page/Dragonmark\" title=\"Dragonmark\">Dragonmark</a>, you get <a href=\"/page/Proficiency:_Bastard_Sword\" title=\"Proficiency: Bastard Sword\">Exotic Weapon Proficiency: Bastard Sword</a> and one of the following:\n<ul><li>Mark of Finding: <span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Fortification\" title=\"Fortification\">Insightful&#32;Fortification  +73%</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Fortification\" title=\"Fortification\">Insightful&#32;Fortification  +73%</a>:</b> +73% <a href=\"/page/Insight_bonus\" title=\"Insight bonus\">Insight bonus</a> to reduced chance of taking critical damage on a critical hit.</span></span></li>\n<li>Mark of Healing: <span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Healing_Amplification\" title=\"Healing Amplification\">Competence Healing Amplification +54</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Healing_Amplification\" title=\"Healing Amplification\">Healing Amplification</a></b>: This effect amplifies all incoming positive energy healing by +54 (<a href=\"/page/Competence_bonus\" title=\"Competence bonus\">Competence bonus</a>). Includes spells, potions, and other effects.</span></span></li>\n<li>Mark of Making: <span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Repair_Amplification\" title=\"Repair Amplification\"> Repair Amplification +54</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Repair_Amplification\" title=\"Repair Amplification\">Repair Amplification</a></b>: This effect amplifies all incoming repair healing by +54 (<a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a>). Includes spells, potions, and other effects.</span></span></li>\n<li>Mark of Passage: <span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Resistance_(enchantment)\" title=\"Resistance (enchantment)\"> Resistance +11</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Resistance_(enchantment)\" title=\"Resistance (enchantment)\"> Resistance +11</a>:</b> Passive: +11 <a href=\"/page/Resistance_bonus\" title=\"Resistance bonus\">Resistance bonus</a> to Fortitude, Reflex, and Will Saving Throws.</span></span></li>\n<li>Mark of Scribing: <span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Shield_Bonus\" class=\"mw-redirect\" title=\"Shield Bonus\">Shield +13</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Shield_Bonus\" class=\"mw-redirect\" title=\"Shield Bonus\">Shield +13</a>:</b> While this item is equipped, you are partially protected by a field of magical force which can deflect enemy attacks. This item provides a +13 Shield bonus to Armor Class. It does not stack with an equipped shield.</span></span></li>\n<li>Mark of Sentinel: <span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Incite\" title=\"Incite\">  Incite +124</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Incite\" title=\"Incite\">  Incite +124</a>:</b> +124% <a href=\"/page/Enhancement_bonus\" title=\"Enhancement bonus\">Enhancement bonus</a> to increased <a href=\"/page/Threat\" class=\"mw-redirect\" title=\"Threat\">threat</a> generation from melee damage</span></span></li>\n<li>Mark of Shadow: <span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Lesser_Displacement\" title=\"Lesser Displacement\">Lesser Displacement</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Lesser_Displacement\" title=\"Lesser Displacement\">Lesser Displacement</a>:</b> Equipping this item causes light to distort around you. Attacks from enemies have a 25% chance to miss you due to concealment.</span></span></li>\n<li>Mark of Storm: <span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Energy_Absorption\" title=\"Energy Absorption\"> Electric Absorption +35%</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Energy_Absorption\" title=\"Energy Absorption\"> Electric Absorption +35%</a>:</b> Passive: 35% Enhancement Bonus to Electric Absorption. (Absorption reduces damage from an element by a percentage, after resistance have been taken into account.)</span></span> and <span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Whirlwind_Ward\" title=\"Whirlwind Ward\">Whirlwind Ward</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Whirlwind_Ward\" title=\"Whirlwind Ward\">Whirlwind Ward</a>:</b> This effect renders you immune to being knocked down by an Air Elemental's whirlwind. However, it does not prevent you from being knocked back or away from touching the Air Elemental.</span></span></li>\n<li>Mark of Warding: <span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Spell_Resistance\" title=\"Spell Resistance\"> Spell Resistance +39</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b> Spell Resistance +39:</b> +39 Enhancement bonus to <a href=\"/page/Spell_Resistance\" title=\"Spell Resistance\">Spell Resistance</a>.</span></span></li></ul></li></ul></li>\n<li><span class=\"popup has&#95;tooltip with-icon basic\"><a href=\"/page/Silver\" title=\"Silver\">Silver</a><span class=\"mw-valign-super\" typeof=\"mw:File\"><span><img src=\"https://images.ddowiki.com/thumb/Icon_tooltip.png/10px-Icon_tooltip.png\" decoding=\"async\" width=\"10\" height=\"8\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/Icon_tooltip.png 1.5x\" /></span></span><span class=\"popup tooltip wide left below\" style=\"text-align: center;\"><b><a href=\"/page/Silver\" title=\"Silver\">Silver</a>:</b> A complex process involving metallurgy and alchemy can bond <b>silver</b> to a <u>weapon made of steel</u> so that it bypasses the damage reduction of creatures such as devils and vampires. <br /> Silver weapons have 2 points lower hardness then equivalent steel weapons, and as such aren't quite as durable.</span></span>  , Alchemical</li>\n<li><style data-mw-deduplicate=\"TemplateStyles:r705465\">.mw-parser-output span.popup.augment.orange>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Orange\"]{background-color:#F4A460;border-color:#0B5B9F}.mw-parser-output span.popup.augment.purple>span.title,.mw-parser-output span.popup.augment>span.popup.tooltip>a[href*=\"Purple\"]{background-color:#DDA0DD;border-color:#225F22}.mw-parser-output span.popup.augment.green>span.title,.mw-parser-output span.popu