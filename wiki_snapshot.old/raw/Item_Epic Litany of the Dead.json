  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><figure class=\"mw-halign-left\" typeof=\"mw:File/Frameless\"><a href=\"/page/Category:Trinket_items\" title=\"Category:Trinket items\"><img src=\"https://images.ddowiki.com/Icon_ItemSlot_Trinket.png\" decoding=\"async\" width=\"32\" height=\"32\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure> \n<h2><span class=\"mw-headline\" id=\"Epic_Litany_of_the_Dead\">Epic Litany of the Dead</span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #FFBBBB solid; margin: 4px; width: 100%; --bg-color-1:#FFBBBB;--bg-color-1-dark:#573F3F;--bg-color-2:#FFE4E1;--bg-color-2-dark:#3D2C2A;--header-color:#FFBBBB;--header-color-dark:#573F3F;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\" width=\"15%\">Minimum level\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\" width=\"42.5%\">26\n</td>\n<th rowspan=\"11\" class=\"bg-color-2\" style=\"background:#FFE4E1\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Trinket_Generic_Litany.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/Trinket_Generic_Litany.png\" decoding=\"async\" width=\"420\" height=\"399\" class=\"mw-file-element\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Item Type\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">Jewelry / Trinket\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\"><a href=\"/page/Slot\" class=\"mw-redirect\" title=\"Slot\">Slot</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">Trinket\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Binding\n</th>\n<td class=\"bg-color-2\" style=\