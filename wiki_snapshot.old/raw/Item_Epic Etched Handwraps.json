  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><table style=\"text-align: center; background-color: #D9D9FF; background-color: rgba(0, 0, 255, 0.15); border: 1px #4A4ABA solid; margin: 0.25em; padding: 0.20em; width: 100%;\">\n\n<tbody><tr style=\"font-size: 1.5em;\">\n<td rowspan=\"3\" style=\"vertical-align: middle; width: 60px;\"><figure class=\"mw-halign-center\" typeof=\"mw:File/Frameless\"><a href=\"/page/File:History_shield-book-sword.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/40px-History_shield-book-sword.png\" decoding=\"async\" width=\"40\" height=\"57\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/60px-History_shield-book-sword.png 1.5x, https://images.ddowiki.com/thumb/History_shield-book-sword.png/80px-History_shield-book-sword.png 2x\" /></a><figcaption></figcaption></figure>\n</td>\n<th><a href=\"/page/Category:History\" title=\"Category:History\">History</a>\n</th>\n<td rowspan=\"3\" style=\"vertical-align: middle; width: 60px;\"><figure class=\"mw-halign-center\" typeof=\"mw:File/Frameless\"><a href=\"/page/File:History_shield-book-sword.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/40px-History_shield-book-sword.png\" decoding=\"async\" width=\"40\" height=\"57\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/thumb/History_shield-book-sword.png/60px-History_shield-book-sword.png 1.5x, https://images.ddowiki.com/thumb/History_shield-book-sword.png/80px-History_shield-book-sword.png 2x\" /></a><figcaption></figcaption></figure>\n</td></tr>\n<tr style=\"font-size: 1.2em;\">\n<td>This item stopped dropping in <a href=\"/page/Update_56\" class=\"mw-redirect\" title=\"Update 56\">Update 56</a>, though since it was unbound until upgraded, it may still appear on the <a href=\"/page/Auction_House\" title=\"Auction House\">Auction House</a>.\n</td></tr>\n<tr style=\"font-size: 0.8em;\">\n<td>If you can verify that the items still drops, please <span class=\"plainlinks\"><a class=\"external text\" href=\"https://ddowiki.com/index.php?title=Item:Epic_Etched_Handwraps&amp;action=edit#editform\"><span class=\"edit-link\" style=\"display: inherit;\" title=\"edit this page\">edit this page</span></a></span> and remove this template.\n</td></tr></tbody></table>\n<h2><span class=\"mw-headline\" id=\"Epic_Etched_Handwraps\">Epic Etched Handwraps</span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #CCFF99 solid; margin: 4px; width: 100%; --bg-color-1:#CCFF99;--bg-color-1-dark:#3D5F1A;--bg-color-2:#EEFFCC;--bg-color-2-dark:#272F17;--header-color:#CCFF99;--header-color-dark:#3D5F1A;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99; width: 15%;\">Proficiency Class\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC; width: 42.5%;\">Exotic Weapon Proficiency\n</td>\n<th class=\"bg-color-2\" rowspan=\"19\" style=\"background:#EEFFCC;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Handwraps_Generic.png\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/Handwraps_Generic.png\" decoding=\"async\" width=\"420\" height=\"389\" class=\"mw-file-element\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Accepts Sentience?\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">No\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Damage and Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">4.20[1d6] + 7 Bludgeon, Silver, Magic\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\"><a href=\"/page/Threat_range\" title=\"Threat range\">Critical threat range</a>\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">20 / x2\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Weapon Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\"><b><a href=\"/page/Handwrap\" title=\"Handwrap\">Handwrap</a></b> / Bludgeoning weapons\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #CCFF99;\">Minimum Level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEFFCC;\">26\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Required Trait\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">None\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\"><a href=\"/page/Use_Magical_Device\" class=\"mw-redirect\" title=\"Use Magical Device\">Use Magical Device</a> <a href=\"/page/DC\" class=\"mw-redirect\" title=\"DC\">DC</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">No UMD needed\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Handedness\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Attack Mod\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">STR\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Damage Mod\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">STR\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><a href=\"/page/Bind\" title=\"Bind\">Unbound</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\">290\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#CF9\">Made from\n</th>\n<td class=\"bg-color-2\" style=\"background:#EFC\"><style data-mw-deduplicate=\"Template