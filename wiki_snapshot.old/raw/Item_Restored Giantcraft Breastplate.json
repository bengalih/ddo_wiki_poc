  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><h2><span class=\"mw-headline\" id=\"Restored_Giantcraft_Breastplate\">Restored Giantcraft Breastplate</span></h2>\n<table style=\"clear: right; border: 1px solid #FFD700; padding: 4px; width: 100%; --bg-color-1:#DDBB00;--bg-color-1-dark:#635400;--bg-color-2:#FFFACD;--bg-color-2-dark:#433E14;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\" width=\"15%\">Armor Type\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\" width=\"42.5%\">Breastplate\n</td>\n<th class=\"bg-color-2\" rowspan=\"15\" style=\"background:#FFFACD;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Giantcraft_Breastplate_shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Giantcraft_Breastplate_shown.jpg/420px-Giantcraft_Breastplate_shown.jpg\" decoding=\"async\" width=\"420\" height=\"276\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/thumb/Giantcraft_Breastplate_shown.jpg/630px-Giantcraft_Breastplate_shown.jpg 1.5x, https://images.ddowiki.com/thumb/Giantcraft_Breastplate_shown.jpg/840px-Giantcraft_Breastplate_shown.jpg 2x\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Feat Requirement\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\">Medium Armor Proficiency\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Race Absolutely Excluded\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\"><a href=\"/page/Warforged\" title=\"Warforged\">Warforged</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #F0DC82;\">Minimum Level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #FFFACD;\">23\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#F0DC82\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFFACD\"><a href=\"/page/Bind\" title=\"Bind\">Bound to Character&#160;on Acq