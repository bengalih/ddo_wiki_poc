  "html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"en\" dir=\"ltr\"><figure class=\"mw-halign-left\" typeof=\"mw:File/Frameless\"><a href=\"/page/Category:Eye_items\" title=\"Category:Eye items\"><img src=\"https://images.ddowiki.com/Icon_ItemSlot_Eye.png\" decoding=\"async\" width=\"32\" height=\"32\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure> \n<h2><span class=\"mw-headline\" id=\"Epic_Goggles_of_the_Inquisition\">Epic Goggles of the Inquisition</span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #FFBBBB solid; margin: 4px; width: 100%; --bg-color-1:#FFBBBB;--bg-color-1-dark:#573F3F;--bg-color-2:#FFE4E1;--bg-color-2-dark:#3D2C2A;--header-color:#FFBBBB;--header-color-dark:#573F3F;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\" width=\"15%\">Minimum level\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\" width=\"42.5%\">23\n</td>\n<th rowspan=\"11\" class=\"bg-color-2\" style=\"background:#FFE4E1\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Epic_Goggles_of_the_Inquisition_shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/Epic_Goggles_of_the_Inquisition_shown.jpg\" decoding=\"async\" width=\"420\" height=\"533\" class=\"mw-file-element\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Item Type\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">Jewelry / Goggles\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\"><a href=\"/page/Slot\" class=\"mw-redirect\" title=\"Slot\">Slot</a>\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">Eye\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><a href=\"/page/Bind\" title=\"Bind\">Bound to Account&#160;on Acquire</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\">240\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background:#FFBBBB\">Material\n</th>\n<td class=\"bg-color-2\" style=\"background:#FFE4E1\"><style data-mw-deduplicate=\"TemplateStyles:r705484\">.mw-parser-output span.popup.has_tooltip{cursor:pointer;position:relative}.mw-parser-output span.popup.has_tooltip.no-icon{border-bottom:1px dashed #999999}.mw-parser-output span.popup.has_tooltip>span.popup.tooltip{background-color:#EEEEEE;background-color:var(--background-color-neutral,#EEEEEE);border:1px solid #333333;border-radius:3px;box-shadow:3px 5px 10px;color:#202122;color:var(--color-base,#202122);cursor:text;display:none;margin:0px;max-width:500px;padding:5px;width:250px;z-index:10000}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.narrow{width:100px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.fill{padding:5px 12px;width:max-content}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.wide{width:450px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.custom{max-width:80vw}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip{display:block;position:absolute}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.above{bottom:100%;top:auto;margin-bottom:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.middle{bottom:auto;top:50%;margin-top:-1em}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.below{bottom:auto;top:100%;margin-top:5px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.left{left:0px;right:auto}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.center{left:50%;margin-left:-125px;right:auto}.mw-parser-output span.popup.has_