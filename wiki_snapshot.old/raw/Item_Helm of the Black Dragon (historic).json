/tr>\n<tr style=\"font-size: 0.8em;\">\n<td>If you can verify that the item still drops, please <span class=\"plainlinks\"><a class=\"external text\" href=\"https://ddowiki.com/index.php?title=Item:Helm_of_the_Black_Dragon_(historic)&amp;action=edit#editform\"><span class=\"edit-link\" style=\"display: inherit;\" title=\"edit this page\">edit this page</span></a></span> and remove this template.\n</td></tr></tbody></table>\n<figure class=\"mw-halign-left\" typeof=\"mw:File/Frameless\"><a href=\"/page/Category:Head_items\" title=\"Category:Head items\"><img src=\"https://images.ddowiki.com/Icon_ItemSlot_Head.png\" decoding=\"async\" width=\"32\" height=\"32\" class=\"mw-file-element\" /></a><figcaption></figcaption></figure> \n<h2><span class=\"mw-headline\" id=\"Helm_of_the_Black_Dragon\"><a href=\"/page/Item:Helm_of_the_Black_Dragon\" class=\"mw-redirect\" title=\"Item:Helm of the Black Dragon\">Helm of the Black Dragon</a></span></h2>\n<table class=\"striped\" style=\"clear: right; border: 1px #DDAAFF solid; margin: 4px; width: 100%; --bg-color-1:#DDA0DD;--bg-color-1-dark:#773777;--bg-color-2:#EEDDFF;--bg-color-2-dark:#3A2F45;--header-color:#DDA0DD;--header-color-dark:#773777;\">\n\n<tbody><tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\" width=\"15%\">Minimum level\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\" width=\"42.5%\">13\n</td>\n<th rowspan=\"11\" class=\"bg-color-2\" style=\"background-color: #EEDDFF;\" width=\"42.5%\" align=\"center\"><span typeof=\"mw:File\"><a href=\"/page/File:Helm_of_the_Black_Dragon_shown.jpg\" class=\"mw-file-description\"><img src=\"https://images.ddowiki.com/thumb/Helm_of_the_Black_Dragon_shown.jpg/420px-Helm_of_the_Black_Dragon_shown.jpg\" decoding=\"async\" width=\"420\" height=\"157\" class=\"mw-file-element\" srcset=\"https://images.ddowiki.com/thumb/Helm_of_the_Black_Dragon_shown.jpg/630px-Helm_of_the_Black_Dragon_shown.jpg 1.5x, https://images.ddowiki.com/thumb/Helm_of_the_Black_Dragon_shown.jpg/840px-Helm_of_the_Black_Dragon_shown.jpg 2x\" /></a></span>\n</th></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Item Type\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">Clothing / Helm\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\"><a href=\"/page/Slot\" class=\"mw-redirect\" title=\"Slot\">Slot</a>\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">Head\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Race Absolutely Required\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\"><a href=\"/page/None\" title=\"None\">None</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Binding\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\"><a href=\"/page/Bind\" title=\"Bind\">Unbound</a>\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Durability\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\">80\n</td></tr>\n<tr>\n<th class=\"bg-color-1\" style=\"background-color: #DDAAFF;\">Material\n</th>\n<td class=\"bg-color-2\" style=\"background-color: #EEDDFF;\"><style data-mw-deduplicate=\"TemplateStyles:r705484\">.mw-parser-output span.popup.has_tooltip{cursor:pointer;position:relative}.mw-parser-output span.popup.has_tooltip.no-icon{border-bottom:1px dashed #999999}.mw-parser-output span.popup.has_tooltip>span.popup.tooltip{background-color:#EEEEEE;background-color:var(--background-color-neutral,#EEEEEE);border:1px solid #333333;border-radius:3px;box-shadow:3px 5px 10px;color:#202122;color:var(--color-base,#202122);cursor:text;display:none;margin:0px;max-width:500px;padding:5px;width:250px;z-index:10000}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.narrow{width:100px}.mw-parser-output span.popup.has_tooltip:hover>span.popup.tooltip.fill{padding:5px 12px;width:max-content}.mw-parser-output sp